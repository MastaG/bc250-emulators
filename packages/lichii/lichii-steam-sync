    ap.add_argument('dir', nargs='?', default=DEFAULT_DIR, help='game folder (default ~/Games/Switch2)')
    ap.add_argument('--emulator', default=None,
                    help='the Lichii the shortcuts start: lichii, lichii-bc250 or a path '
                         '(default lichii-bc250 when installed, else lichii)')
    ap.add_argument('--native-mesh', action=argparse.BooleanOptionalAction, default=None,
                    help='lichii shortcuts without EDEN_NX2_FORCE_MESH_FALLBACK=1 (remembered)')
    ap.add_argument('--env', action='append', default=None, metavar='NAME=VALUE',
                    help='environment variable for every Lichii shortcut (repeatable, remembered)')
    ap.add_argument('--clear-env', action='store_true', help='drop the remembered environment variables')
    ap.add_argument('--migrate', action='store_true',
                    help='point shortcuts of other Lichii/Eglantine builds at this emulator')
    ap.add_argument('--prune', action='store_true', help='remove shortcuts of deleted games without asking')
    ap.add_argument('--refresh-art', action='store_true', help='fetch the artwork again, replacing what is there')
    ap.add_argument('--dry-run', action='store_true', help='show what would change, change nothing')
    ap.add_argument('--collection', default=COLLECTION,
                    help='Steam collection with all Lichii shortcuts (default %r)' % COLLECTION)
    ap.add_argument('--no-collection', action='store_true', help='leave Steam collections alone')
    ap.add_argument('--add-self', action='store_true',
                    help='only add (or repair) the %r shortcut that runs this script from Steam' % SELF_NAME)
    ap.add_argument(SELF_OPTION, dest='from_steam', action='store_true', help=argparse.SUPPRESS)
    ap.add_argument('--add-self-once', action='store_true', help=argparse.SUPPRESS)   # package hook
    ap.add_argument('--ensure-self', action='store_true',
                    help='like --add-self, but only while Steam is not running (the user unit that '
                         'runs before Steam starts)')
    if '--apply-collections' in sys.argv[1:]:   # the unit collections_kick starts
        return apply_collections()
    a = ap.parse_args()
    if not a.dry_run:
        collections_kick()
    if a.from_steam:
        detach_from_steam(SELF_TOOL, sys.argv[1:])
    if os.environ.get('BC250_SYNC_DETACHED'):
        # Started from Steam: let the shortcut's own launch end before looking for a running game.
        for _ in range(15):
            if not game_running():
                break
            time.sleep(1)
    lock = steam_lock()                      # noqa: F841 (held until exit)
    games_dir = os.path.abspath(os.path.expanduser(a.dir))
    if not os.path.isdir(games_dir) and (a.add_self or a.add_self_once or a.ensure_self):
        os.makedirs(games_dir, exist_ok=True)       # where the games go; the shortcut syncs it
    emulator = pick_emulator(a.emulator)
    print('emulator: %s' % emulator)
    dry = a.dry_run
    if not os.path.isdir(games_dir):
        raise SystemExit('%s does not exist: put the Switch 2 games there, or name the folder' % games_dir)
    if not os.path.exists(emulator):
        print('  ! %s is missing: the shortcuts start it' % emulator)

    try:
        vdf = find_shortcuts_vdf(create=not a.dry_run)
    except SystemExit:
        if a.ensure_self or a.add_self_once:   # login unit / package hook before Steam's first login
            print('no Steam account yet: the shortcut is added at a login after Steam has been set up')
            return 0
        raise
    account = os.path.basename(os.path.dirname(os.path.dirname(vdf)))
    if not a.dry_run and os.path.isfile(vdf) and not steam_running():
        forget_self_play(vdf, SELF_TOOL)
    if a.ensure_self:                         # the user unit, before Steam starts
        if steam_running():
            print('Steam is already running: the shortcut is checked at the next login')
            return 0
        a.add_self = True
    if a.add_self_once:                       # the package hook: once per Steam account
        if os.path.exists(self_marker(SELF_TOOL, account)):
            print('the Steam shortcut was added for account %s before: left alone' % account)
            return 0
        a.add_self = True
    grid = os.path.join(os.path.dirname(vdf), 'grid')
    os.makedirs(grid, exist_ok=True)
    state_path = os.path.join(games_dir, STATE_NAME)
    state = load_state(games_dir)
    settings = state.pop(SETTINGS_KEY, None)
    settings = settings if isinstance(settings, dict) else {}
    env = list(settings.get('env') or [])
    if a.clear_env:
        env = []
    if a.env:
        bad = [e for e in a.env if not ENV_ASSIGN.match(e)]
        if bad:
            raise SystemExit('--env needs NAME=VALUE, not: %s' % ', '.join(bad))
        names = {e.split('=', 1)[0] for e in a.env}
        env = [e for e in env if e.split('=', 1)[0] not in names] + a.env
    settings['env'] = env
    if a.native_mesh is not None:
        settings['native_mesh'] = a.native_mesh
    env = shortcut_env(env, emulator, bool(settings.get('native_mesh')))
    if env:
        print('environment for the shortcuts: %s' % ' '.join(env))

    top = vdf_read(vdf)
    entries = top['shortcuts']
    by_game = {}
    taken = set()
    self_k = None
    for k, e in entries.items():
        taken.add(int(e.get('appid', 0)) & 0xffffffff)
        g = entry_game(e)
        if g:
            by_game.setdefault(g, k)
        if self_k is None and is_self_entry(e, SELF_TOOL):
            self_k = k
    if self_k is not None and not os.path.exists(self_marker(SELF_TOOL, account)) and not dry:
        self_mark(SELF_TOOL, account)

    games = sorted(os.path.join(games_dir, f) for f in os.listdir(games_dir)
                   if f.lower().endswith(GAME_EXTS) and not f.startswith('.'))
    if a.add_self:
        games = []                                  # --add-self: only the own shortcut
    key = sgdb_key()
    print('games: %d in %s; artwork from %s' % (len(games), games_dir,
                                                'SteamGridDB' if key else "Nintendo's store"))
    add, update = [], {}
    art_new = False                                 # artwork written for a shortcut Steam has already
    for g in games:
        st = state.get(g, {})
        name = clean_name(os.path.basename(g))
        if 'meta' not in st or a.refresh_art:
            st['meta'] = nintendo_lookup(name)
        meta = st['meta']
        title = (meta or {}).get('title') or name
        print('- %s' % title)
        if meta:
            print('  %s, %s; %s' % (meta.get('publisher') or '?', meta.get('released') or '?',
                                    ', '.join(meta.get('genres') or []) or '-'))
        else:
            print('  (not found in Nintendo\'s store, name from the file)')
        genv = env_for(g, title, env)
        if genv != list(BASE_ENV) + env:
            print('  environment: %s' % ' '.join(genv[len(BASE_ENV):]))
        k = by_game.get(g)
        appid = (int(entries[k]['appid']) & 0xffffffff) if k else new_appid(g, taken)
        sgdb = sgdb_art(key, title) if key and (a.refresh_art or not os.path.exists(
            os.path.join(grid, ART['cover'][0] % appid))) else {}
        icon = sync_art(appid, meta, sgdb, grid, a.refresh_art, dry)
        if k and appid in ART_WRITTEN:
            art_new = True
        if k:
            e = entries[k]
            ours = os.path.realpath(unquote(e.get('exe', ''))) == os.path.realpath(emulator)
            if not ours and not a.migrate:
                print('  shortcut: kept, it starts %s (--migrate switches it to %s)'
                      % (unquote(e.get('exe', '')), emulator))
            else:
                change = {}
                if e.get('appname') != title:
                    change['appname'] = title
                if icon and e.get('icon') != icon:
                    change['icon'] = icon
                if not ours:
                    change['exe'] = '"%s"' % emulator
                if e.get('LaunchOptions') != launch_options(g, genv):
                    change['LaunchOptions'] = launch_options(g, genv)
                if change:
                    update[k] = change
                    print('  shortcut: update (%s)' % ', '.join(sorted(change)))
                else:
                    print('  shortcut: ok')
        else:
            add.append(new_entry(appid, title, g, icon, emulator, genv))
            print('  shortcut: new (appid %d)' % appid)
        st['appid'] = appid
        state[g] = st

    dead = [] if a.add_self else [k for g, k in by_game.items() if not os.path.exists(g)]
    remove = []
    for k in dead:
        text = 'game file gone: "%s" (%s) -- remove the shortcut?' % (
            entries[k].get('appname'), entry_game(entries[k]))
        if a.prune:
            print(text + '  [--prune -> yes]')
            remove.append(k)
        elif not dry and ask(text):
            remove.append(k)
        elif dry:
            print(text + '  [dry run]')

    # This script's own shortcut: added once (and with --add-self), see "its own shortcut" above. Without
    # --add-self it doesn't stop Steam by itself: it comes with the next change.
    self_set = self_fields(SELF_TOOL, SELF_NAME)
    self_change = {}
    if a.add_self or (self_k is None and not os.path.exists(self_marker(SELF_TOOL, account))):
        if self_k is not None:
            self_change = {f: v for f, v in self_set.items() if entries[self_k].get(f) != v}
        if (self_k is None or self_change) and (a.add_self or add or update or remove or not steam_running()):
            if self_k is not None:
                update[self_k] = dict(update.get(self_k, {}), **self_change)
                print('- %s: shortcut update (%s)' % (SELF_NAME, ', '.join(sorted(self_change))))
            else:
                add.append(self_entry(new_appid(' '.join((SELF_TOOL, SELF_OPTION, self_seed())), taken), SELF_TOOL, SELF_NAME))
                print('- %s: shortcut new (%s %s)' % (SELF_NAME, self_set['exe'], SELF_OPTION))
    self_ids = [int(entries[self_k].get('appid', 0)) & 0xffffffff] if self_k is not None else []

    # Steam collection: every Lichii shortcut (new ones too), none of the removed ones.
    drop_ids = {int(entries[k].get('appid', 0)) & 0xffffffff for k in remove}
    keep_ids = [int(e.get('appid', 0)) & 0xffffffff for k, e in entries.items()
                if entry_game(e) and k not in remove] + [int(e['appid']) & 0xffffffff for e in add] + self_ids
    coll = None
    need_coll = False
    if not a.no_collection and a.collection.strip():
        coll_path = collection_file(vdf)
        _, coll_idx, coll = collection_read(coll_path, a.collection.strip())
        if coll is None:
            print('  ! no Steam cloud storage yet (%s): start Steam once, then run this again '
                  'for the %r collection' % (coll_path, a.collection))
        else:
            _, plus, minus = collection_change(coll, keep_ids, drop_ids)
            need_coll = bool(plus or minus)
            print('collection %r%s: %d to add, %d to take out'
                  % (coll['name'], '' if coll_idx is not None else ' (new)', len(plus), len(minus)))

    if dry:
        print('dry run: nothing changed')
        return 0
    state[SETTINGS_KEY] = settings
    with open(state_path + '.tmp', 'w') as fh:
        json.dump(state, fh, indent=1, sort_keys=True)
    os.replace(state_path + '.tmp', state_path)
    art_restart = art_new and steam_running()
    if not (add or update or remove or need_coll or art_restart):
        print('Steam shortcuts are up to date.')
        return 0

    how = None
    if steam_running():
        if game_running():
            raise SystemExit('a game is running: close it and run this again')
        print('stopping Steam to write its shortcut list ...' if add or update or remove or need_coll
              else 'stopping Steam so it shows the new artwork ...')
        how = steam_stop()
        if not how:
            raise SystemExit('Steam did not stop, nothing written')
    try:
        top = vdf_read(vdf)                         # Steam may have saved it on exit
        entries = top['shortcuts']
        for k, change in update.items():
            if k in entries:
                entries[k].update(change)
        for k in remove:
            entries.pop(k, None)
        items = list(entries.values()) + add
        top['shortcuts'] = collections.OrderedDict((str(i), e) for i, e in enumerate(items))
        if add or update or remove:
            vdf_write(vdf, top)
            if any(is_self_entry(e, SELF_TOOL) for e in top['shortcuts'].values()):
                self_mark(SELF_TOOL, account)
            print('shortcuts: %d added, %d updated, %d removed' % (len(add), len(update), len(remove)))
        if need_coll:
            # Read again: Steam writes the file when it exits.
            data, idx, coll = collection_read(coll_path, coll['name'])
            if coll is not None:
                coll, plus, minus = collection_change(coll, keep_ids, drop_ids)
                if plus or minus:
                    collection_write(coll_path, data, idx, coll)
                    print('collection %r: %d added, %d taken out (%d in it)'
                          % (coll['name'], len(plus), len(minus), len(coll['added'])))
    finally:
        if how:
            forget_self_play(vdf, SELF_TOOL)   # Steam is stopped here
        if how:
            print('starting Steam again')
            steam_start(how)
    return 0


if __name__ == '__main__':
    sys.exit(main())
