def _state_dir():
    return os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'), '.local/state')


def _pending_path():
    return os.path.join(_state_dir(), 'bc250-steam-collections.json')


def _steam_root(path):
    """Steam's folder for a cloud-storage file .../Steam/userdata/<id>/config/cloudstorage/<file>."""
    return os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(path)))))


def _pending_change(change):
    """Run change(pending dict) under a lock and save the result."""
    import fcntl
    os.makedirs(_state_dir(), exist_ok=True)
    with open(_pending_path() + '.lock', 'w') as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            with open(_pending_path(), encoding='utf-8') as fh:
                pending = json.load(fh)
            if not isinstance(pending, dict):
                pending = {}
        except (OSError, ValueError):
            pending = {}
        change(pending)
        pending = {k: v for k, v in pending.items() if v}
        if pending:
            with open(_pending_path() + '.tmp', 'w', encoding='utf-8') as fh:
                json.dump(pending, fh, indent=1, sort_keys=True)
            os.replace(_pending_path() + '.tmp', _pending_path())
        elif os.path.exists(_pending_path()):
            os.remove(_pending_path())
        return pending


def collections_kick(steam_root=None):
    """Let Steam open its debugging port at its next start, and start the unit that makes the queued
    collections once Steam is up (when anything is queued and it isn't running yet)."""
    if not os.path.exists(_pending_path()):
        return
    roots = [steam_root] if steam_root else [os.path.join(os.path.expanduser('~'), '.local/share/Steam')]
    for root in roots:
        if root and os.path.isdir(root):
            open(os.path.join(root, '.cef-enable-remote-debugging'), 'a').close()
    unit = 'bc250-steam-collections'
    if subprocess.run(['systemctl', '--user', 'is-active', '--quiet', unit]).returncode == 0:
        return
    cmd = [sys.executable or 'python3', os.path.abspath(__file__), '--apply-collections']
    if shutil.which('systemd-run'):
        subprocess.run(['systemctl', '--user', 'reset-failed', unit], stderr=subprocess.DEVNULL)
        if subprocess.run(['systemd-run', '--user', '--collect', '--quiet', '--unit=' + unit] + cmd).returncode == 0:
            return
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def collection_write(path, data, index, coll):
    """Write the collection. Already in the cloud (and clean): its shortcuts into localconfig.vdf. New, or
    its definition still holds shortcuts: queued for Steam to make (see above)."""
    added = list(coll['added']) + [a for a in coll.get('_local_prev', []) if a not in coll['added']]
    if index is None or coll.get('_dirty'):
        account = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(path))))

        def queue(pending):
            mine = pending.setdefault(account, {})
            mine[coll['name']] = sorted(set(mine.get(coll['name'], [])) | set(added))
        _pending_change(queue)
        collections_kick(_steam_root(path))
        print('  collection %r: queued for Steam to make at its next start (%d shortcut%s)'
              % (coll['name'], len(added), '' if len(added) == 1 else 's'))
        return
    text, local = _local_read(path)
    if text is None:
        print('  ! no %s yet (start Steam once): collection %r left alone' % (_localconfig(path), coll['name']))
        return
    local[coll['id']] = {'id': coll['id'], 'added': added, 'removed': list(coll['removed'])}
    # Shortcuts that older versions of this script filed under an id of their own ("bc250-...") whose
    # definition never reached the cloud: Steam has no collection for them, so they go.
    known = {str(item[0])[len('user-collections.'):] for item in data
             if isinstance(item, list) and item and str(item[0]).startswith('user-collections.')}
    for cid in [c for c in local if c.startswith('bc250-') and c not in known and c != coll['id']]:
        del local[cid]
    _local_write(path, text, local)


# ------------------------------------------- the Steam client, over its CEF debugging port (stdlib only)
def _cdp_eval(expr, timeout=30):
    """Evaluate JavaScript in the Steam client's SharedJSContext; -> its value (promises awaited)."""
    import base64
    import socket
    import struct
    import urllib.request
    with urllib.request.urlopen('http://127.0.0.1:%d/json' % CDP_PORT, timeout=5) as r:
        url = next((t['webSocketDebuggerUrl'] for t in json.load(r) if t.get('title') == 'SharedJSContext'), None)
    if not url:
        raise OSError('no SharedJSContext yet')
    hostport, wspath = url.split('://', 1)[1].split('/', 1)
    host, port = hostport.rsplit(':', 1)
    if host not in ('127.0.0.1', 'localhost'):
        raise OSError('debugger not on localhost: %s' % host)
    s = socket.create_connection((host, int(port)), timeout=timeout)
    try:
        key = base64.b64encode(os.urandom(16)).decode()
        s.sendall(('GET /%s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n'
                   'Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n' % (wspath, hostport, key)).encode())
        buf = b''
        while b'\r\n\r\n' not in buf:
            chunk = s.recv(4096)
            if not chunk:
                raise OSError('debugger closed the connection')
            buf += chunk
        if b' 101 ' not in buf.split(b'\r\n', 1)[0]:
            raise OSError('debugger refused the websocket')
        buf = buf.split(b'\r\n\r\n', 1)[1]
        msg = json.dumps({'id': 1, 'method': 'Runtime.evaluate',
                          'params': {'expression': expr, 'awaitPromise': True, 'returnByValue': True}}).encode()
        n = len(msg)
        head = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else bytes([0x80 | 126]) + struct.pack('>H', n)
                                if n < 65536 else bytes([0x80 | 127]) + struct.pack('>Q', n))
        mask = os.urandom(4)
        s.sendall(head + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(msg)))

        def read(k):
            nonlocal buf
            while len(buf) < k:
                chunk = s.recv(65536)
                if not chunk:
                    raise OSError('debugger closed the connection')
                buf += chunk
            out, buf = buf[:k], buf[k:]
            return out
        while True:
            parts = []
            while True:
                b0, b1 = read(2)
                k = b1 & 0x7f
                if k == 126:
                    k = struct.unpack('>H', read(2))[0]
                elif k == 127:
                    k = struct.unpack('>Q', read(8))[0]
                if b1 & 0x80:
                    read(4)
                parts.append(read(k))
                if b0 & 0x80:
                    break
            reply = json.loads(b''.join(parts).decode())
            if reply.get('id') == 1:
                res = reply.get('result', {})
                if 'exceptionDetails' in res:
                    raise OSError('JavaScript error: %s' % json.dumps(res['exceptionDetails'])[:300])
                return res.get('result', {}).get('value')
    finally:
        s.close()


_APPLY_JS = '''(async () => {
  if (typeof collectionStore === 'undefined' || typeof appStore === 'undefined') return 'notready';
  const want = %s;
  if (want.some(a => !appStore.GetAppOverviewByAppID(a))) return 'notready';
  let c = collectionStore.GetUserCollectionsByName(%s)[0];
  if (!c) { c = collectionStore.NewUnsavedCollection(%s, undefined, []); await c.Save(); }
  const id = c.id;
  const have = new Set(collectionStore.GetCollection(id).allApps.map(a => a.appid));
  const add = want.filter(a => !have.has(a));
  if (add.length) {
    collectionStore.AddOrRemoveApp(add, true, id);
    await collectionStore.GetCollection(id).Save();     // the live one: a saved NewUnsavedCollection is a copy
  }
  return id;
})()'''


def apply_collections(wait=900):
    """--apply-collections: make the queued collections through the running Steam client (waits for it)."""
    deadline = time.time() + wait
    while time.time() < deadline:
        try:
            with open(_pending_path(), encoding='utf-8') as fh:
                pending = json.load(fh)
        except (OSError, ValueError):
            return 0
        try:
            sid = _cdp_eval('App && App.m_CurrentUser ? App.m_CurrentUser.strSteamID : ""')
        except (OSError, ValueError):
            time.sleep(5)
            continue
        if not sid:
            time.sleep(5)
            continue
        account = str(int(sid) - STEAMID64_BASE)
        mine = pending.get(account) or {}
        if not mine:
            print('nothing queued for the logged-in account %s' % account)
            return 0
        done = []
        for name, apps in sorted(mine.items()):
            try:
                cid = _cdp_eval(_APPLY_JS % (json.dumps([int(a) for a in apps]), json.dumps(name), json.dumps(name)))
            except (OSError, ValueError) as exc:
                print('  ! collection %r: %s' % (name, exc))
                continue
            if cid == 'notready':
                continue
            print('collection %r: made/updated by Steam (%s, %d shortcut%s)'
                  % (name, cid, len(apps), '' if len(apps) == 1 else 's'))
            done.append(name)

        def drop(p):
            for name in done:
                if p.get(account, {}).get(name) == mine[name]:
                    p[account].pop(name, None)
        left = _pending_change(drop).get(account)
        if not left:
            return 0
        time.sleep(5)
    print('Steam was not ready in %d s: the collections stay queued for the next run' % wait)
    return 1


# ----------------------------------------------------------- its own shortcut
# The script adds a shortcut that starts itself (--from-steam), so it can be run from Big Picture /
# Gaming Mode. Steam has to be stopped to write shortcuts.vdf, which would stop a child of Steam too:
# started from Steam, the script runs again in a systemd user unit of its own and returns at once.
# Once added, a marker remembers it: a shortcut the user deleted is only added again with --add-self.

SELF_OPTION = '--from-steam'


def self_marker(tool, account):
    """One per Steam account: each account has its own shortcut list."""
    state = os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'), '.local/state')
    return os.path.join(state, tool, 'steam-shortcut-added-%s' % account)


def self_mark(tool, account):
    path = self_marker(tool, account)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'w') as fh:
            fh.write(time.strftime('%Y-%m-%d %H:%M:%S\n'))
    except OSError:
        pass


def steam_lock():
    """One sync script at a time: kytyps5-steam-sync and lichii-steam-sync both rewrite Steam's
    shortcut list and collections (their user units start together at login). Held until exit."""
    import fcntl
    state = os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'), '.local/state')
    os.makedirs(state, exist_ok=True)
    fh = open(os.path.join(state, 'bc250-steam-sync.lock'), 'w')
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print('waiting for the other Steam sync script to finish ...', flush=True)
        fcntl.flock(fh, fcntl.LOCK_EX)
    return fh


def forget_self_play(vdf_path, tool):
    """Keep this script's own shortcut off Steam's "Recent games": clear its last-played time in
    shortcuts.vdf and drop it from RecentLocalPlayedGameIDs in localconfig.vdf (16-byte records:
    the 64-bit game id, a shortcut's being appid << 32 | 0x02000000, then the time). Only while
    Steam is stopped: Steam writes both files when it exits."""
    try:
        top = vdf_read(vdf_path)
        top = top[0] if isinstance(top, tuple) else top
        ids = set()
        for e in top['shortcuts'].values():
            if is_self_entry(e, tool):
                ids.add(int(e.get('appid', 0)) & 0xffffffff)
                if e.get('LastPlayTime'):
                    e['LastPlayTime'] = 0
                    vdf_write(vdf_path, top)
        path = os.path.join(os.path.dirname(vdf_path), 'localconfig.vdf')
        if not ids or not os.path.isfile(path):
            return
        with open(path, encoding='utf-8') as fh:
            text = fh.read()
        m = re.search(r'"RecentLocalPlayedGameIDs"\s+"([0-9a-fA-F]*)"', text)
        if not m or len(m.group(1)) % 32:
            return
        raw = bytes.fromhex(m.group(1))
        recs = [raw[i:i + 16] for i in range(0, len(raw), 16)]
        keep = [r for r in recs if struct.unpack('<Q', r[:8])[0] not in
                {a << 32 | 0x02000000 for a in ids}]
        if len(keep) == len(recs):
            return
        tmp = path + '.tmp-%d' % os.getpid()
        with open(tmp, 'w', encoding='utf-8') as fh:
            fh.write(text[:m.start(1)] + b''.join(keep).hex() + text[m.end(1):])
        shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except (OSError, ValueError, KeyError, SystemExit) as exc:
        print('  ! could not take %r off "Recent games": %s' % (tool, exc))


def self_seed():
    """Per machine and user: Steam knows the shortcuts of all machines of an account (to stream them),
    and gives a shortcut whose id another machine already uses a new id, which the collection then lacks."""
    try:
        with open('/etc/machine-id') as fh:
            mid = fh.read().strip()
    except OSError:
        mid = os.uname().nodename
    return '%s %s' % (mid, os.path.expanduser('~'))


def self_exe(tool):
    """The script as Steam should start it: /usr/bin/<tool> when installed, else this file."""
    installed = shutil.which(tool)
    here = os.path.realpath(sys.argv[0])
    return installed if installed and os.path.realpath(installed) == here else here


def is_self_entry(entry, tool):
    exe = entry.get('exe', '')
    exe = exe[1:-1] if len(exe) > 1 and exe[0] == exe[-1] == '"' else exe
    return os.path.basename(exe) == tool and SELF_OPTION in entry.get('LaunchOptions', '')


def self_fields(tool, name):
    """The fields that make the shortcut what it is (others stay as the user set them)."""
    return {'appname': name, 'exe': '"%s"' % self_exe(tool),
            'StartDir': '"%s"' % os.path.expanduser('~'), 'LaunchOptions': SELF_OPTION}


def self_entry(appid, tool, name):
    e = collections.OrderedDict()
    e['appid'] = appid - 0x100000000 if appid >= 0x80000000 else appid
    f = self_fields(tool, name)
    e['appname'] = f['appname']
    e['exe'] = f['exe']
    e['StartDir'] = f['StartDir']
    e['icon'] = ''
    e['ShortcutPath'] = ''
    e['LaunchOptions'] = f['LaunchOptions']
    e['IsHidden'] = 0
    e['AllowDesktopConfig'] = 1
    e['AllowOverlay'] = 1
    e['OpenVR'] = 0
    e['Devkit'] = 0
    e['DevkitGameID'] = ''
    e['DevkitOverrideAppID'] = 0
    e['LastPlayTime'] = 0
    e['FlatpakAppID'] = ''
    e['sortas'] = ''
    e['tags'] = collections.OrderedDict()
    return e


def detach_from_steam(tool, argv):
    """Started by Steam: run this script again, without --from-steam, in the user unit <tool>.service
    (outside Steam's process tree, so stopping Steam doesn't stop it). Its output: journalctl --user
    -u <tool>. Returns only when already detached."""
    if os.environ.get('BC250_SYNC_DETACHED'):
        return
    cmd = ['systemd-run', '--user', '--collect', '--quiet', '--unit=%s' % tool,
           '-E', 'BC250_SYNC_DETACHED=1']
    for name in ('HOME', 'DISPLAY', 'WAYLAND_DISPLAY', 'XAUTHORITY', 'XDG_RUNTIME_DIR',
                 'DBUS_SESSION_BUS_ADDRESS'):
        if os.environ.get(name):
            cmd += ['-E', '%s=%s' % (name, os.environ[name])]
    subprocess.run(['systemctl', '--user', 'reset-failed', tool + '.service'],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # From Steam there is no terminal to ask in: shortcuts of games that are gone are removed.
    args = [a for a in argv if a != SELF_OPTION] + ['--prune']
    os.execvp('systemd-run', cmd + [sys.executable, os.path.realpath(sys.argv[0])] + args)


# ------------------------------------------------------------------------ steam
def _run(cmd, timeout=60):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ''


def steam_unit_active():
    return _run(['systemctl', '--user', 'is-active', STEAM_UNIT]) == 'active'


def steam_running():
    return steam_unit_active() or bool(_run(['pgrep', '-u', str(os.getuid()), '-x', 'steam']))


def game_running():
    return bool(_run(['pgrep', '-u', str(os.getuid()), '-f', 'SteamLaunch AppId=']))


def steam_stop():
    how = 'unit' if steam_unit_active() else 'desktop'
    if how == 'unit':
        # Masked, like kytyps5-run does: the PS5 Gaming Mode session then waits for Steam to come
        # back instead of ending (steam_start unmasks it).
        _run(['systemctl', '--user', 'mask', '--runtime', STEAM_UNIT])
        _run(['systemctl', '--user', 'stop', STEAM_UNIT])
    elif shutil.which('steam'):
        subprocess.Popen(['steam', '-shutdown'], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(60):
        if not steam_running():
            return how
        time.sleep(1)
    return None


def steam_start(how):
    if how == 'unit':
        _run(['systemctl', '--user', 'unmask', '--runtime', STEAM_UNIT])
        _run(['systemctl', '--user', 'start', STEAM_UNIT])
    elif shutil.which('steam'):
        subprocess.Popen(['steam'], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


# ------------------------------------------------------------ names, metadata
def clean_name(filename):
    name = os.path.splitext(filename)[0]
    name = re.sub(r'\[[^\]]*\]|\([^)]*\)', ' ', name)
    name = re.split(r'\s\+\s', name)[0]
    name = name.replace('_', ' ')
    return re.sub(r'\s+', ' ', name).strip()


def norm(s):
    return re.sub(r'[^a-z0-9]+', '', s.lower())


def http_get(url, headers=None, timeout=30):
    req = urllib.request.Request(url, headers=dict({'User-Agent': UA}, **(headers or {})))
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def nintendo_lookup(name):
    """Best Switch 2 match in Nintendo's (EU) store search, or None."""
    q = urllib.parse.urlencode({'q': name, 'fq': 'type:GAME', 'rows': 30, 'wt': 'json'})
    try:
        docs = json.loads(http_get('%s?%s' % (NINTENDO_SEARCH, q)))['response']['docs']
    except Exception as exc:                        # noqa: BLE001 - network is best effort
        print('  ! Nintendo search failed: %s' % exc)
        return None
    best, score = None, 0.0
    for d in docs:
        if 'Nintendo Switch 2' not in (d.get('system_names_txt') or []):
            continue
        s = difflib.SequenceMatcher(None, norm(name), norm(d.get('title', ''))).ratio()
        if s > score:
            best, score = d, s
    if not best or score < 0.75:
        return None

    def full(url):                                  # the 500w thumbnail -> the original
        return url.replace('_image500w', '') if url else None
    return {
        'title': best.get('title'),
        'publisher': best.get('publisher'),
        'released': (best.get('dates_released_dts') or [''])[0][:10],
        'genres': best.get('pretty_game_categories_txt') or [],
        'age_rating': best.get('pretty_agerating_s'),
        'description': best.get('excerpt') or best.get('product_catalog_description_s'),
        'url': 'https://www.nintendo.com' + best['url'] if best.get('url') else None,
        'square': full(best.get('image_url_sq_s')),
        'wide': full(best.get('image_url_h16x9_s') or best.get('image_url_h2x1_s')),
    }


def sgdb_key():
    key = os.environ.get('SGDB_API_KEY', '').strip()
    p = os.path.join(HOME, '.config/steamgriddb_api_key')
    if not key and os.path.isfile(p):
        with open(p) as fh:
            key = fh.read().strip()
    return key or None


def sgdb_art(key, title):
    """{kind: url} from SteamGridDB for the closest game, best rated first."""
    h = {'Authorization': 'Bearer ' + key}
    try:
        res = json.loads(http_get('%s/search/autocomplete/%s' % (SGDB, urllib.parse.quote(title)), h))
        if not res.get('data'):
            return {}
        gid = res['data'][0]['id']
        out = {}
        for kind, path in (('cover', 'grids/game/%d?dimensions=600x900' % gid),
                           ('banner', 'grids/game/%d?dimensions=920x430,460x215' % gid),
                           ('hero', 'heroes/game/%d' % gid), ('logo', 'logos/game/%d' % gid),
                           ('icon', 'icons/game/%d' % gid)):
            data = json.loads(http_get('%s/%s' % (SGDB, path), h)).get('data') or []
            if data:
                out[kind] = data[0]['url']
        return out
    except Exception as exc:                        # noqa: BLE001
        print('  ! SteamGridDB failed: %s' % exc)
        return {}


# --------------------------------------------------------------------- artwork
def load_image(url):
    from PIL import Image
    try:
        data = http_get(url)
    except Exception:                               # noqa: BLE001 - try the thumbnail
        data = http_get(url.replace('.jpg', '_image500w.jpg'))
    im = Image.open(io.BytesIO(data))
    im.load()
    return im.convert('RGBA')


def save_png(im, path):
    tmp = path + '.tmp'
    im.save(tmp, 'PNG')
    os.replace(tmp, path)


def make_from_nintendo(meta, kind):
    """Steam's sizes cut from Nintendo's square and 16:9 key art."""
    from PIL import ImageFilter, ImageOps, ImageEnhance
    size = ART[kind][1]
    if kind in ('banner', 'hero') and meta.get('wide'):
        return ImageOps.fit(load_image(meta['wide']), size, centering=(0.5, 0.4))
    if kind == 'icon' and meta.get('square'):
        return ImageOps.fit(load_image(meta['square']), size)
    if kind == 'cover' and meta.get('square'):
        sq = load_image(meta['square'])
        bg = ImageOps.fit(load_image(meta['wide']) if meta.get('wide') else sq, size)
        bg = ImageEnhance.Brightness(bg.filter(ImageFilter.GaussianBlur(28))).enhance(0.55)
        fg = sq.resize((size[0], size[0]))
        bg.alpha_composite(fg, (0, (size[1] - size[0]) // 2))
        return bg
    return None


ART_WRITTEN = []    # appids sync_art wrote artwork for in this run


def sync_art(appid, meta, sgdb, grid, refresh, dry):
    """Write the missing artwork; -> path of the icon (or '')."""
    got = []
    for kind, (pattern, _) in ART.items():
        dst = os.path.join(grid, pattern % appid)
        if os.path.exists(dst) and not refresh:
            continue
        if dry:
            got.append(kind)
            continue
        try:
            if kind in sgdb:
                im = load_image(sgdb[kind])
                if kind == 'icon':
                    im = im.resize(ART['icon'][1])
            elif meta:
                im = make_from_nintendo(meta, kind)
            else:
                im = None
        except Exception as exc:                    # noqa: BLE001
            print('  ! %s: %s' % (kind, exc))
            im = None
        if im is not None:
            save_png(im, dst)
            got.append(kind)
    if got:
        print('  art: %s%s' % (', '.join(got), ' (would fetch)' if dry else ''))
        if not dry:
            ART_WRITTEN.append(appid)
    icon = os.path.join(grid, ART['icon'][0] % appid)
    return icon if os.path.exists(icon) or (dry and 'icon' in got) else ''


