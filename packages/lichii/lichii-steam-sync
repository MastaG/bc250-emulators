# --------------------------------------------------------------- shortcuts.vdf
END, SEC, STR, INT = 0x08, 0x00, 0x01, 0x02


def _cstr(buf, off):
    end = buf.index(b'\x00', off)
    return buf[off:end].decode('utf-8', 'surrogateescape'), end + 1


def vdf_parse(buf, off=0):
    out = collections.OrderedDict()
    while off < len(buf):
        t = buf[off]
        if t == END:
            return out, off + 1
        if t not in (SEC, STR, INT):
            raise ValueError('unknown type %02x at offset %d' % (t, off))
        name, off = _cstr(buf, off + 1)
        if t == SEC:
            val, off = vdf_parse(buf, off)
        elif t == STR:
            val, off = _cstr(buf, off)
        else:
            val = struct.unpack('<i', buf[off:off + 4])[0]
            off += 4
        key, n = name, 2
        while key in out:
            key, n = '%s#%d' % (name, n), n + 1
        out[key] = val
    raise ValueError('section without end byte')


def vdf_serialize(members):
    out = bytearray()
    for key, val in members:
        kb = str(key).split('#')[0].encode('utf-8', 'surrogateescape')
        if isinstance(val, dict):
            out += bytes([SEC]) + kb + b'\x00' + vdf_serialize(list(val.items())) + bytes([END])
        elif isinstance(val, int):
            out += bytes([INT]) + kb + b'\x00' + struct.pack('<i', val)
        else:
            out += bytes([STR]) + kb + b'\x00' + str(val).encode('utf-8', 'surrogateescape') + b'\x00'
    return bytes(out)


# What Steam itself writes for a user without non-Steam shortcuts.
EMPTY_VDF = b'\x00shortcuts\x00\x08\x08'


def vdf_read(path):
    if not os.path.exists(path):
        data = EMPTY_VDF                      # --dry-run before Steam has one
    else:
        with open(path, 'rb') as fh:
            data = fh.read()
    top, _ = vdf_parse(data)
    if vdf_serialize(list(top.items())) + b'\x08' != data:
        raise SystemExit('%s does not round-trip, refusing to rewrite it' % path)
    if not isinstance(top.get('shortcuts'), dict):
        raise SystemExit('%s has no "shortcuts" section' % path)
    return top


def vdf_write(path, top):
    shutil.copy2(path, path + '.bak-lichii-steam-sync')
    tmp = '%s.tmp-%d' % (path, os.getpid())
    with open(tmp, 'wb') as fh:
        fh.write(vdf_serialize(list(top.items())) + b'\x08')
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


def active_steam_user(root):
    """userdata id of the account Steam logs into: MostRecent "1" in config/loginusers.vdf, else the
    newest login timestamp (Steam leaves MostRecent out with one account). None if unknown."""
    try:
        with open(os.path.join(root, 'config', 'loginusers.vdf'), encoding='utf-8', errors='replace') as fh:
            text = fh.read()
    except OSError:
        return None
    best = None
    for m in re.finditer(r'"(\d{17})"\s*\{(.*?)\}', text, re.S):
        body = m.group(2)
        recent = re.search(r'"mostrecent"\s*"1"', body, re.I) is not None
        ts = re.search(r'"timestamp"\s*"(\d+)"', body, re.I)
        key = (recent, int(ts.group(1)) if ts else 0)
        if best is None or key > best[0]:
            best = (key, str(int(m.group(1)) - 76561197960265728))
    return best[1] if best else None


def find_shortcuts_vdf(create=True):
    # The account Steam logs into first; else (several accounts, none known as active) the longest list.
    for root in sorted({os.path.realpath(os.path.join(HOME, p))
                        for p in ('.local/share/Steam', '.steam/root')}):
        active = active_steam_user(root)
        conf = os.path.join(root, 'userdata', active or '', 'config')
        if active and os.path.isdir(conf):
            p = os.path.join(conf, 'shortcuts.vdf')
            if not os.path.isfile(p):
                if create:
                    with open(p, 'wb') as fh:
                        fh.write(EMPTY_VDF)
                    print('no shortcuts.vdf yet, started an empty one: %s' % p)
                else:
                    print('no shortcuts.vdf yet, a real run starts an empty one: %s' % p)
            return p
    best = None
    for root in sorted({os.path.realpath(os.path.join(HOME, p))
                        for p in ('.local/share/Steam', '.steam/root')}):
        ud = os.path.join(root, 'userdata')
        for user in os.listdir(ud) if os.path.isdir(ud) else []:
            p = os.path.join(ud, user, 'config/shortcuts.vdf')
            if os.path.isfile(p):
                n = len(vdf_read(p)['shortcuts'])
                if best is None or n > best[0]:
                    best = (n, p)
    if best:
        return best[1]
    # No non-Steam shortcut was ever added, so Steam has not written shortcuts.vdf yet.
    # Start an empty one for the account that used Steam last (newest localconfig.vdf).
    newest = None
    for root in sorted({os.path.realpath(os.path.join(HOME, p))
                        for p in ('.local/share/Steam', '.steam/root')}):
        ud = os.path.join(root, 'userdata')
        for user in os.listdir(ud) if os.path.isdir(ud) else []:
            lc = os.path.join(ud, user, 'config/localconfig.vdf')
            if (user.isdigit() and user != '0' and os.path.isfile(lc)
                    and not os.path.exists(os.path.join(ud, user, 'config/shortcuts.vdf'))):
                m = os.path.getmtime(lc)
                if newest is None or m > newest[0]:
                    newest = (m, os.path.join(ud, user, 'config/shortcuts.vdf'))
    if not newest:
        raise SystemExit('no Steam account found -- is Steam installed, and has it run once?')
    if create:
        with open(newest[1], 'wb') as fh:
            fh.write(EMPTY_VDF)
        print('no shortcuts.vdf yet, started an empty one: %s' % newest[1])
    else:
        print('no shortcuts.vdf yet, a real run starts an empty one: %s' % newest[1])
    return newest[1]


def unquote(v):
    v = (v or '').strip()
    return v[1:-1] if len(v) > 1 and v[0] == v[-1] == '"' else v


def is_switch_shortcut(entry):
    return bool(EMULATOR_NAME.match(os.path.basename(unquote(entry.get('exe', '')))))


def entry_game(entry):
    """The game file a Lichii/Eglantine shortcut starts, or None for other shortcuts."""
    if not is_switch_shortcut(entry):
        return None
    try:
        toks = shlex.split(entry.get('LaunchOptions', ''))
    except ValueError:
        return None
    for tok in toks:
        if tok.lower().endswith(GAME_EXTS):
            return os.path.abspath(tok)
    return None


def pick_emulator(requested):
    """The emulator the shortcuts start: --emulator (a name of EMULATORS or a path),
    else lichii-bc250 when it is installed, else lichii."""
    if requested:
        return os.path.abspath(os.path.expanduser(EMULATORS.get(requested, requested)))
    have = [name for name, path in EMULATORS.items() if os.path.exists(path)]
    if 'lichii-bc250' in have:
        if 'lichii' in have:
            print('Note: both lichii and lichii-bc250 installed, choosing lichii-bc250, '
                  'please use --emulator to change it.')
        return EMULATORS['lichii-bc250']
    return EMULATORS['lichii']


def shortcut_env(env, emulator, native_mesh):
    """The environment of the shortcuts: the remembered --env, and for plain lichii
    the mesh fallback (lichii-bc250's launcher sets that itself)."""
    names = {e.split('=', 1)[0] for e in env}
    if (not native_mesh and os.path.basename(emulator) == 'lichii'
            and MESH_FALLBACK.split('=', 1)[0] not in names):
        return env + [MESH_FALLBACK]
    return env


def env_for(game, title, env):
    """A shortcut's environment: BASE_ENV, the game's GAME_ENV, then env (the remembered
    --env and the mesh fallback); a later NAME replaces an earlier one."""
    m = TITLE_ID.search(os.path.basename(game))
    tid = m.group(1).lower() if m else None
    out = list(BASE_ENV)
    for gid, pattern, extra in GAME_ENV:
        if (tid == gid) if tid else bool(pattern.search(title or os.path.basename(game))):
            out += extra
    out += env
    merged = collections.OrderedDict()
    for e in out:
        name = e.split('=', 1)[0]
        merged.pop(name, None)
        merged[name] = e
    return list(merged.values())


def launch_options(game, env):
    """Steam's launch options: optional environment, then Lichii's own arguments."""
    args = '%s %s' % (LAUNCH_FLAGS, shlex.quote(game) if '"' in game else '"%s"' % game)
    if env:
        return '%s %%command%% %s' % (' '.join(shlex.quote(e) for e in env), args)
    return args


def new_appid(seed, taken):
    x = int.from_bytes(hashlib.md5(seed.encode('utf-8', 'surrogateescape')).digest()[:4], 'big')
    x = (x >> 1) | 0x80000000
    while x in taken:
        x = ((x + 1) & 0x7fffffff) | 0x80000000
    taken.add(x)
    return x


def signed(appid):
    return appid - 0x100000000 if appid >= 0x80000000 else appid


def new_entry(appid, name, game, icon, emulator, env):
    e = collections.OrderedDict()
    e['appid'] = signed(appid)
    e['appname'] = name
    e['exe'] = '"%s"' % emulator
    e['StartDir'] = '"%s/"' % os.path.dirname(game)
    e['icon'] = icon
    e['ShortcutPath'] = ''
    e['LaunchOptions'] = launch_options(game, env)
    e['IsHidden'] = 0
    e['AllowDesktopConfig'] = 1
    e['AllowOverlay'] = 1
    e['OpenVR'] = 0
    e['Devkit'] = 0
    e['DevkitGameID'] = ''
    e['DevkitOverrideAppID'] = 0
    e['LastPlayTime'] = 0
    e['FlatpakAppID'] = ''
    e['sortas'] = ''
    e['tags'] = collections.OrderedDict([('0', TAG)])
    return e


# ------------------------------------------------------------- Steam collection
# A Steam collection has two halves (the client's ToStorageFormat: roamingData + localData):
#  - its definition, in Steam Cloud: userdata/<id>/config/cloudstorage/cloud-storage-namespace-<n>.json,
#    a list of ["user-collections.<id>", {"key", "timestamp", "value", "version"}] whose value is
#    {"id", "name", "added": [Steam appids], "removed": [...]}. Steam uploads an entry only when its key is
#    queued in cloud-storage-namespace-<n>.modified.json (a list of keys), and at a later start replaces
#    every entry the cloud doesn't have; an entry holding non-Steam shortcuts is never kept.
#  - the non-Steam shortcuts in it, on this machine only: localconfig.vdf, "WebStorage" ->
#    "user-collections", a JSON map {id: {"id", "added": [shortcut appids], "removed": [...]}}.
# A definition written into that file by another program is not reliably uploaded (tested 2026-11-24: one
# upload out of five tries), so a collection that is new (or whose definition still holds shortcuts, as
# older versions of this script wrote them) is made by Steam itself: its name and shortcuts are queued in
# ~/.local/state/bc250-steam-collections.json and `<this script> --apply-collections` (a transient user
# unit) waits for Steam and makes it through the client's own collectionStore, over the CEF debugging port
# that Steam opens on 127.0.0.1:8080 when ~/.local/share/Steam/.cef-enable-remote-debugging exists (Decky
# uses the same port). Shortcuts of a collection that is already in the cloud go straight into
# localconfig.vdf, with Steam stopped. A shortcut's appid is the unsigned 32-bit one of shortcuts.vdf,
# always >= 0x80000000. Steam must be stopped for the file writes: it writes both files on exit.

SHORTCUT_BIT = 0x80000000


def collection_file(vdf_path):
    """The cloud-storage file that holds the collections (namespace 1 unless another one has them)."""
    folder = os.path.join(os.path.dirname(vdf_path), 'cloudstorage')
    ns = 1
    try:
        with open(os.path.join(folder, 'cloud-storage-namespaces.json'), encoding='utf-8') as fh:
            for nid, _ in json.load(fh):
                try:
                    with open(os.path.join(folder, 'cloud-storage-namespace-%d.json' % int(nid)),
                              encoding='utf-8') as f2:
                        if '"user-collections.' in f2.read():
                            ns = int(nid)
                            break
                except OSError:
                    continue
    except (OSError, ValueError, TypeError):
        pass
    return os.path.join(folder, 'cloud-storage-namespace-%d.json' % ns)


def _localconfig(path):
    """localconfig.vdf of the account whose cloud-storage file is `path`."""
    return os.path.join(os.path.dirname(os.path.dirname(path)), 'localconfig.vdf')


_LOCAL_RE = re.compile(r'("user-collections"[ \t]+")((?:[^"\\]|\\.)*)(")')


def _vdf_unescape(s):
    return re.sub(r'\\(.)', r'\1', s)


def _vdf_escape(s):
    return s.replace('\\', '\\\\').replace('"', '\\"')


def _local_read(path):
    """-> (localconfig.vdf text or None, its user-collections map)."""
    try:
        with open(_localconfig(path), encoding='utf-8') as fh:
            text = fh.read()
    except OSError:
        return None, {}
    m = _LOCAL_RE.search(text)
    if not m:
        return text, {}
    try:
        local = json.loads(_vdf_unescape(m.group(2)))
    except ValueError:
        return text, {}
    return text, local if isinstance(local, dict) else {}


def _local_write(path, text, local):
    """Put the user-collections map into localconfig.vdf (into its WebStorage block, made when missing)."""
    value = _vdf_escape(json.dumps(local, separators=(',', ':')))
    m = _LOCAL_RE.search(text)
    if m:
        text = text[:m.start(2)] + value + text[m.end(2):]
    else:
        w = re.search(r'\n([ \t]*)"WebStorage"[ \t]*\n[ \t]*\{[ \t]*\n', text)
        if w:
            ind = w.group(1) + '\t'
            text = text[:w.end()] + '%s"user-collections"\t\t"%s"\n' % (ind, value) + text[w.end():]
        else:
            top = re.search(r'"UserLocalConfigStore"[ \t]*\n[ \t]*\{[ \t]*\n', text)
            if not top:
                raise ValueError('no UserLocalConfigStore block')
            text = (text[:top.end()] + '\t"WebStorage"\n\t{\n\t\t"user-collections"\t\t"%s"\n\t}\n' % value
                    + text[top.end():])
    lp = _localconfig(path)
    shutil.copy2(lp, lp + '.bak-bc250')             # one copy, replaced each time
    with open(lp + '.tmp', 'w', encoding='utf-8') as fh:
        fh.write(text)
    os.replace(lp + '.tmp', lp)


def collection_read(path, name):
    """-> (file entries, index of the definition or None, the collection). The collection is found by
    its name (any case), so one made by hand in Steam (or by Steam ROM Manager) is used too; else a new
    one is returned. Its 'added'/'removed' are the shortcuts in it on this machine (localconfig.vdf).
    When the definition is missing from the cloud file, or still holds shortcuts (written by an older
    version of this script), 'added' is empty, so that a caller adds its shortcuts again and
    collection_write repairs the definition. An account without a cloud-storage file yet gets an empty
    entry list: collection_write makes the file. (None, None, None) when the file can't be used."""
    try:
        with open(path, encoding='utf-8') as fh:
            data = json.load(fh)
    except FileNotFoundError:
        data = []
    except ValueError as exc:
        print('  ! %s: %s -- collection left alone' % (path, exc))
        return None, None, None
    if not isinstance(data, list):
        return None, None, None
    index, roaming = None, None
    for i, item in enumerate(data):
        if not (isinstance(item, list) and len(item) == 2 and isinstance(item[1], dict)
                and str(item[0]).startswith('user-collections.')):
            continue
        if item[1].get('is_deleted') or not item[1].get('value'):
            continue
        try:
            coll = json.loads(item[1]['value'])
        except ValueError:
            continue
        if isinstance(coll, dict) and str(coll.get('name', '')).strip().upper() == name.strip().upper():
            index, roaming = i, coll
            break
    if roaming is None:
        cid = 'bc250-' + ''.join('%02x' % b for b in hashlib.md5(name.encode('utf-8')).digest()[:6])
        roaming = {'id': cid, 'name': name, 'added': [], 'removed': []}
    roaming['added'] = [int(a) for a in roaming.get('added') or []]
    roaming['removed'] = [int(a) for a in roaming.get('removed') or []]
    _, local = _local_read(path)
    mine = local.get(roaming['id']) if isinstance(local.get(roaming['id']), dict) else {}
    added = [int(a) for a in mine.get('added') or []]
    removed = [int(a) for a in mine.get('removed') or []]
    dirty = index is None or any(a & SHORTCUT_BIT for a in roaming['added'] + roaming['removed'])
    coll = {'id': roaming['id'], 'name': roaming.get('name') or name,
            'added': [] if dirty else added, 'removed': removed,
            '_roaming': roaming, '_dirty': dirty, '_local_prev': added if dirty else []}
    return data, index, coll


def collection_change(coll, want, drop):
    """-> (new collection, appids added, appids taken out): every appid of `want` in it, no appid of
    `drop`; nothing else of the collection is touched (games put in it by hand stay)."""
    want = [a for a in want if a not in drop]
    added = [a for a in coll['added'] if a not in drop]
    plus = [a for a in want if a not in added]
    minus = [a for a in coll['added'] if a in drop]
    new = dict(coll, added=added + plus, removed=[a for a in coll['removed'] if a not in want])
    return new, plus, minus


