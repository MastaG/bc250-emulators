# Maintainer: MastaG
#
# Lichii (https://github.com/zortos293/lichii): a Nintendo Switch 2 emulator
# (Eden-based), built for the BC-250 instead of upstream's generic x86-64
# AppImage. Built from upstream's newest release (tag build-<n>), which
# scripts/resolve-lichii.sh pins into @LICHII_TAG@ / @LICHII_COMMIT@; CI
# rebuilds it whenever that release moves. pkgver is upstream's build number.
#
# Split package:
# - lichii: the emulator (/usr/bin/lichii), the command-line version
#   (/usr/bin/lichii-cli) and the multiplayer room server (/usr/bin/lichii-room).
#   Upstream names the last two eden-cli and eden-room, the names the Eden
#   emulator installs too; they are renamed so both can be installed.
# - lichii-steam-sync, our own (arch any): adds the Switch 2 games of a folder
#   (~/Games/Switch2) to Steam as lichii shortcuts, with artwork. lichii
#   depends on it, so it is always installed with the emulator.
#
# Until 2026-11-12 this package was called lichii-bc250. That name now belongs
# to the BC-250 fork of Lichii (packages/lichii-bc250). The old builds are
# versioned by upstream's build number (e.g. 150), the fork by commit date
# (e.g. 20261112.r30626.g83071fda4), so the versioned replaces below moves only
# the old builds over to this package and leaves an installed fork alone.
#
# Differences from upstream's linux-x86_64-pgo release:
# - CPU target -march=znver2 -mtune=znver2 (upstream: generic x86-64), minus
#   the two Zen 2 instructions the BC-250 cannot use: RDSEED is broken on this
#   APU (every call "succeeds" with 0xffffffff; the kernel hides it at boot,
#   "RDSEED is not reliable on this platform; disabling") and XSAVES is not
#   used by the kernel here. -mno-rdseed keeps compiled code from calling
#   RDSEED directly instead of asking CPUID; -mno-xsaves is for exactness only
#   (XSAVES is a kernel-mode instruction). All other packages in this repo use
#   -march=x86-64-v3, which has neither.
# - The same PGO profile as upstream (eglantine.profdata, trained by upstream
#   with clang 23, which is also Arch's clang), plus ThinLTO (upstream's Linux
#   builds have no LTO).
# - The system's Qt 6, SDL3, FFmpeg, Boost, OpenSSL, fmt and other libraries
#   where Arch has them; Vulkan headers and utility libraries bundled, as
#   upstream's CI does. CPM fetches and builds in the rest (Opus, zstd, cubeb,
#   QuaZip, ...) while configuring, so build() needs the network.
# - No update checker: pacman updates it.
pkgbase=lichii
pkgname=('lichii' 'lichii-steam-sync')
_name=lichii
_tag=@LICHII_TAG@
_commit=@LICHII_COMMIT@
pkgver=@LICHII_BUILD@
pkgrel=@PKGREL@
pkgdesc="Nintendo Switch 2 emulator (Lichii), built for the BC-250 with PGO and ThinLTO"
arch=('x86_64')
url="https://github.com/zortos293/lichii"
license=('GPL-3.0-or-later')
makedepends=('git' 'cmake' 'ninja' 'clang' 'lld' 'llvm' 'glslang' 'spirv-tools'
             'spirv-headers' 'qt6-base' 'qt6-charts' 'qt6-tools' 'sdl3' 'ffmpeg'
             'boost' 'boost-libs' 'openssl' 'fmt' 'libusb' 'enet' 'lz4' 'brotli'
             'zlib' 'libxkbcommon' 'nlohmann-json' 'nasm' 'pkgconf' 'mesa' 'libva'
             'libvdpau' 'libpulse' 'alsa-lib' 'vulkan-icd-loader')
# Our own LTO and flags below.
options=('!lto' '!debug' 'strip')
source=("$_name::git+https://github.com/zortos293/lichii.git#commit=${_commit}"
        'lichii-steam-sync')
sha256sums=('SKIP'
            'SKIP')

build() {
    local profile="$srcdir/$_name/eglantine.profdata"
    # BC-250: Zen 2 without RDSEED/XSAVES (see the header). Upstream's PGO
    # warnings are silenced the same way its CI does; -Werror is off because
    # our flags are not the ones upstream tests with. makepkg's own flags are
    # replaced on purpose: the emulator's JIT maps guest code itself, and
    # upstream only ever tests its own flags.
    local cpu="-march=znver2 -mtune=znver2 -mno-rdseed -mno-xsaves"
    local pgo="-fprofile-use=$profile -Wno-backend-plugin -Wno-profile-instr-unprofiled -Wno-profile-instr-out-of-date"
    export CFLAGS="$cpu -flto=thin $pgo"
    export CXXFLAGS="$CFLAGS"
    export LDFLAGS="-fuse-ld=lld -flto=thin -Wl,-O2"
    # CPM's downloads stay inside the build tree.
    export CPM_SOURCE_CACHE="$srcdir/cpm-cache"

    cmake -S "$_name" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DBUILD_TESTING=OFF \
        -DYUZU_TESTS=OFF \
        -DYUZU_CMD=ON \
        -DYUZU_ROOM=ON \
        -DYUZU_ROOM_STANDALONE=ON \
        -DYUZU_USE_BUNDLED_QT=OFF \
        -DYUZU_USE_BUNDLED_SDL3=OFF \
        -DYUZU_USE_BUNDLED_FFMPEG=OFF \
        -DVulkanHeaders_FORCE_BUNDLED=ON \
        -DVulkanUtilityLibraries_FORCE_BUNDLED=ON \
        -DENABLE_QT_TRANSLATION=ON \
        -DENABLE_UPDATE_CHECKER=OFF \
        -DENABLE_WERROR=OFF \
        -DUSE_DISCORD_PRESENCE=OFF \
        -DLICHII_BUILD_TAG="${_tag}" \
        -DLICHII_BUILD_PLATFORM=linux-x86_64-bc250
    cmake --build build
}

package_lichii() {
    # Linked: the libraries in the binaries' NEEDED lists. Loaded at run time
    # (dlopen): the Vulkan loader, and PulseAudio/ALSA through the bundled
    # cubeb. Boost, OpenSSL, FFmpeg and fmt change their sonames on Arch
    # updates; CI rebuilds this with every Lichii release.
    depends=('qt6-base' 'qt6-charts' 'sdl3' 'ffmpeg' 'boost-libs' 'openssl' 'fmt'
             'libusb' 'enet' 'lz4' 'brotli' 'zlib' 'libxkbcommon' 'libglvnd'
             'gcc-libs' 'glibc' 'vulkan-icd-loader' 'libpulse' 'alsa-lib'
             'hicolor-icon-theme' 'lichii-steam-sync')
    optdepends=('gamemode: Feral GameMode while a game runs')
    conflicts=("$_name-git")
    replaces=('lichii-bc250<1000000')

    DESTDIR="$pkgdir" cmake --install build
    # eden-cli / eden-room are also what the Eden emulator installs.
    mv "$pkgdir/usr/bin/eden-cli" "$pkgdir/usr/bin/lichii-cli"
    mv "$pkgdir/usr/bin/eden-room" "$pkgdir/usr/bin/lichii-room"
    install -Dm644 "$_name/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
    cp -r --no-preserve=ownership "$_name/LICENSES" "$pkgdir/usr/share/licenses/$pkgname/"
}

package_lichii-steam-sync() {
    pkgdesc="Add Nintendo Switch 2 games to Steam as Lichii shortcuts, with artwork"
    arch=('any')
    license=('GPL-2.0-only')
    depends=('python' 'python-pillow')
    optdepends=('lichii: Lichii, /usr/bin/lichii (lichii-steam-sync --emulator lichii)'
                'lichii-bc250: the BC-250 fork, /usr/bin/lichii-bc250 (the default when installed)')

    install -Dm755 lichii-steam-sync "$pkgdir/usr/bin/lichii-steam-sync"
}
