# Maintainer: MastaG
#
# lichii-bc250 (https://github.com/lethevimlet/lichii-bc250): a fork of Lichii
# (packages/lichii) tuned for the BC-250 itself: RADV query/semaphore fixes,
# the task/mesh shader fallback Zelda: Ocarina of Time needs, memory work for
# 16 GB of shared RAM and frame pacing. The fork has no releases: CI builds the
# newest commit of its main branch, which scripts/resolve-lichii-bc250.sh pins
# into @LICHII_BC250_COMMIT@, and rebuilds when it moves.
#
# Built the way packages/lichii is (the same flags, system libraries and
# ThinLTO), with the fork's own PGO profile (lichii-linux.profdata, the one its
# installer uses). Its installer, tools/bc250/bc250-install.sh, builds only the
# command-line version inside a Fedora distrobox; this package also builds the
# Qt emulator and the room server. What the installer adds besides the build:
# - a launcher that sets the fork's BC-250 tuning variables: that is
#   lichii-bc250-env, sourced by /usr/bin/lichii-bc250 and lichii-bc250-cli.
#   It also sends mesh draws to Lichii's compute fallback
#   (EDEN_NX2_FORCE_MESH_FALLBACK=1), which the fork's installer does not need:
#   Bazzite's Mesa has no mesh shaders, this repo's (DirectMesh) does;
#   The two Ocarina-of-Time-only ones (30 Hz tick, swap interval 2) are left
#   out; the example in /usr/share/doc/lichii-bc250 has them;
# - its per-game settings for Ocarina of Time (oot.ini), installed as that
#   example, not used by default;
# - system tuning (UMA, swappiness, compaction, swapfile, TTM limit): outside
#   a package's business, see the README.
#
# Installs beside packages/lichii: the binaries are lichii-bc250,
# lichii-bc250-cli and lichii-bc250-room, the real ones and libnxformat live in
# /usr/lib/lichii-bc250, and the desktop entry, icon, MIME and AppStream files
# carry the fork's own id (io.github.lethevimlet.lichii-bc250). Both read the
# same Eden folders (~/.config/eden, ~/.local/share/eden, ~/.cache/eden), as
# the fork's README says.
#
# The name lichii-bc250 belonged to the plain Lichii build (now packages/lichii,
# which replaces 'lichii-bc250<1000000') until 2026-11-12. Those were versioned
# by upstream's build number (150 and so on); the commit date that starts this
# package's version is far above that, so no epoch is needed (an epoch puts a
# ':' in the file name, which GitHub release assets turn into a '.').
pkgname=lichii-bc250
_name=lichii-bc250
_commit=@LICHII_BC250_COMMIT@
pkgver=0
pkgrel=@PKGREL@
pkgdesc="Nintendo Switch 2 emulator (lethevimlet's Lichii fork, tuned for the BC-250), with PGO and ThinLTO"
arch=('x86_64')
url="https://github.com/lethevimlet/lichii-bc250"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-charts' 'sdl3' 'ffmpeg' 'boost-libs' 'openssl' 'fmt'
         'libusb' 'enet' 'lz4' 'brotli' 'zlib' 'libxkbcommon' 'libglvnd'
         'gcc-libs' 'glibc' 'vulkan-icd-loader' 'libpulse' 'alsa-lib'
         'hicolor-icon-theme' 'lichii-steam-sync')
makedepends=('git' 'cmake' 'ninja' 'clang' 'lld' 'llvm' 'glslang' 'spirv-tools'
             'spirv-headers' 'qt6-tools' 'boost' 'nlohmann-json' 'nasm' 'pkgconf'
             'mesa' 'libva' 'libvdpau')
optdepends=('gamemode: Feral GameMode while a game runs')
# Our own LTO and flags below.
options=('!lto' '!debug' 'strip')
source=("$_name::git+https://github.com/lethevimlet/lichii-bc250.git#commit=${_commit}"
        'lichii-bc250-env'
        'lichii-bc250-wrapper')
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

pkgver() {
    cd "$_name"
    # No releases or tags: commit date, then the commit count, which rises with
    # every push to main (the date keeps the version rising even if it ever
    # does not).
    printf '%s.r%s.g%s' "$(git log -1 --format=%cd --date=format:%Y%m%d)" \
        "$(git rev-list --count HEAD)" "$(git rev-parse --short=9 HEAD)"
}

prepare() {
    cd "$_name"
    # While the fork still links libnxformat as a shared library, it goes to
    # the fork's own folder, so it never clashes with an old /usr/lib/lichii.
    # The binaries move there too (package()), so the run path is the folder
    # itself. Upstream links it statically since #1232 (build-160); once the
    # fork has that too there is nothing to move.
    local cm=src/yuzu/CMakeLists.txt
    grep -qF 'DESTINATION "${CMAKE_INSTALL_LIBDIR}/lichii")' "$cm" || return 0
    grep -qF 'INSTALL_RPATH "\$ORIGIN/../${CMAKE_INSTALL_LIBDIR}/lichii")' "$cm"
    sed -i -e 's|INSTALL_RPATH "\\$ORIGIN/../${CMAKE_INSTALL_LIBDIR}/lichii")|INSTALL_RPATH "\\$ORIGIN")|' \
        -e 's|DESTINATION "${CMAKE_INSTALL_LIBDIR}/lichii")|DESTINATION "${CMAKE_INSTALL_LIBDIR}/lichii-bc250")|' "$cm"
    grep -qF 'INSTALL_RPATH "\$ORIGIN")' "$cm"
}

build() {
    local profile="$srcdir/$_name/lichii-linux.profdata"
    # BC-250: Zen 2 without RDSEED/XSAVES, as in packages/lichii (see there).
    local cpu="-march=znver2 -mtune=znver2 -mno-rdseed -mno-xsaves"
    local pgo="-fprofile-use=$profile -Wno-backend-plugin -Wno-profile-instr-unprofiled -Wno-profile-instr-out-of-date"
    export CFLAGS="$cpu -flto=thin $pgo"
    export CXXFLAGS="$CFLAGS"
    export LDFLAGS="-fuse-ld=lld -flto=thin -Wl,-O2"
    export CPM_SOURCE_CACHE="$srcdir/cpm-cache"

    cmake -S "$_name" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DBUILD_TESTING=OFF \
        -DYUZU_TESTS=OFF \
        -DYUZU_CMD=ON \
        -DYUZU_ROOM=ON \
        -DYUZU_ROOM_STANDALONE=ON \
        -DYUZU_USE_BUNDLED_QT=OFF \
        -DYUZU_USE_BUNDLED_SDL3=OFF \
        -DYUZU_USE_BUNDLED_FFMPEG=OFF \
        -DVulkanHeaders_FORCE_BUNDLED=ON \
        -DVulkanUtilityLibraries_FORCE_BUNDLED=ON \
        -DENABLE_QT_TRANSLATION=ON \
        -DENABLE_UPDATE_CHECKER=OFF \
        -DENABLE_WEB_SERVICE=OFF \
        -DENABLE_WERROR=OFF \
        -DUSE_DISCORD_PRESENCE=OFF \
        -DLICHII_BUILD_TAG="lichii-bc250-${pkgver}" \
        -DLICHII_BUILD_PLATFORM=linux-x86_64-bc250
    cmake --build build
}

package() {
    local stage="$srcdir/stage" lib="$pkgdir/usr/lib/$_name" id=io.github.lethevimlet.lichii-bc250
    rm -rf "$stage"
    DESTDIR="$stage" cmake --install build

    # The real binaries (beside libnxformat while it is shared); /usr/bin gets
    # the launchers.
    install -d "$lib" "$pkgdir/usr/bin"
    install -m755 "$stage/usr/bin/lichii" "$lib/lichii-bc250"
    install -m755 "$stage/usr/bin/eden-cli" "$lib/lichii-bc250-cli"
    install -m755 "$stage/usr/bin/eden-room" "$pkgdir/usr/bin/lichii-bc250-room"
    if compgen -G "$stage/usr/lib/$_name/libnxformat.so*" >/dev/null; then
        install -m755 "$stage/usr/lib/$_name/"libnxformat.so* "$lib/"
    fi
    install -m644 lichii-bc250-env "$lib/lichii-bc250-env"
    install -m755 lichii-bc250-wrapper "$pkgdir/usr/bin/lichii-bc250"
    ln -s lichii-bc250 "$pkgdir/usr/bin/lichii-bc250-cli"

    # Desktop integration under the fork's own id.
    local share="$stage/usr/share"
    sed -e "s/^Name=.*/Name=Lichii (BC-250)/" \
        -e "s/^Icon=.*/Icon=$id/" \
        -e "s/^TryExec=.*/TryExec=lichii-bc250/" \
        -e "s/^Exec=lichii /Exec=lichii-bc250 /" \
        "$share/applications/io.github.zortos293.lichii.desktop" > "$srcdir/$id.desktop"
    grep -qx 'Exec=lichii-bc250 %f' "$srcdir/$id.desktop"
    install -Dm644 "$srcdir/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
    install -Dm644 "$share/icons/hicolor/256x256/apps/io.github.zortos293.lichii.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/$id.png"
    install -Dm644 "$share/mime/packages/io.github.zortos293.lichii.xml" \
        "$pkgdir/usr/share/mime/packages/$id.xml"
    sed -e "s/io\.github\.zortos293\.lichii/$id/g" "$share/metainfo/io.github.zortos293.lichii.metainfo.xml" \
        > "$srcdir/$id.metainfo.xml"
    install -Dm644 "$srcdir/$id.metainfo.xml" "$pkgdir/usr/share/metainfo/$id.metainfo.xml"

    # The fork's Ocarina of Time settings and the variables its launcher adds.
    local doc="$pkgdir/usr/share/doc/$pkgname"
    install -d "$doc"
    sed -n "/^    cat > \"\$APP_DIR\/oot.ini\" <<'INI'\$/,/^INI\$/p" "$_name/tools/bc250/bc250-install.sh" |
        sed '1d;$d' > "$doc/oot.ini"
    [[ -s "$doc/oot.ini" ]]
    install -m644 "$_name/README.md" "$_name/CHANGELOG.md" "$doc/"

    install -Dm644 "$_name/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
    cp -r --no-preserve=ownership "$_name/LICENSES" "$pkgdir/usr/share/licenses/$pkgname/"
}
