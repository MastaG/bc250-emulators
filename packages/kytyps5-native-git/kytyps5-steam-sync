# --------------------------------------------------------------- shortcuts.vdf
# Binary VDF: 0x00 section (name NUL, body until 0x08), 0x01 string (name NUL,
# value NUL), 0x02 int32 LE (name NUL, 4 bytes), 0x08 ends the current section.
# A shortcuts.vdf carries one 0x08 more than its sections need; keep it byte for
# byte or Steam rewrites the whole file on its next start.
END, SEC, STR, INT = 0x08, 0x00, 0x01, 0x02


def _cstr(buf, off):
    end = buf.index(b'\x00', off)
    return buf[off:end].decode('utf-8', 'surrogateescape'), end + 1


def vdf_parse(buf, off=0, end=None):
    """-> (OrderedDict of the section's members, offset past its 0x08)."""
    if end is None:
        end = len(buf)
    out = collections.OrderedDict()
    while off < end:
        t = buf[off]
        if t == END:
            return out, off + 1
        if t not in (SEC, STR, INT):
            raise ValueError('unknown type %02x at offset %d' % (t, off))
        name, off = _cstr(buf, off + 1)
        if t == SEC:
            val, off = vdf_parse(buf, off, end)
        elif t == STR:
            val, off = _cstr(buf, off)
        else:
            val = struct.unpack('<i', buf[off:off + 4])[0]
            off += 4
        key, n = name, 2
        while key in out:                       # keep a repeated key, never drop it
            key, n = '%s#%d' % (name, n), n + 1
        out[key] = val
    raise ValueError('section at offset %d has no end byte' % off)


def vdf_serialize(members):
    out = bytearray()
    for key, val in members:
        kb = str(key).encode('utf-8', 'surrogateescape')
        if b'\x00' in kb:
            raise ValueError('NUL in key %r' % key)
        if isinstance(val, dict):
            out += bytes([SEC]) + kb + b'\x00' + \
                vdf_serialize(list(val.items())) + bytes([END])
        elif isinstance(val, int):
            out += bytes([INT]) + kb + b'\x00' + struct.pack('<i', val)
        else:
            vb = ('' if val is None else str(val)).encode('utf-8', 'surrogateescape')
            if b'\x00' in vb:
                raise ValueError('NUL in the value of %r' % key)
            out += bytes([STR]) + kb + b'\x00' + vb + b'\x00'
    return bytes(out)


# What Steam itself writes for a user without non-Steam shortcuts.
EMPTY_VDF = b'\x00shortcuts\x00\x08\x08'


def vdf_read(path):
    """-> (top, entries). Refuses to guess: the file has to round-trip byte for
    byte before it is rewritten, so any layout we do not know stops us here."""
    if not os.path.exists(path):
        data = EMPTY_VDF                      # --dry-run / --list before Steam has one
    else:
        with open(path, 'rb') as fh:
            data = fh.read()
    try:
        top, _ = vdf_parse(data)
        again = vdf_serialize(list(top.items())) + b'\x08'
    except ValueError as exc:
        raise SystemExit('%s: %s -- not a shortcuts.vdf this script knows' % (path, exc))
    if again != data:
        raise SystemExit('%s parses to something that is not the same file, refusing to '
                         'rewrite it (Steam may still be writing it)' % path)
    entries = top.get('shortcuts')
    if not isinstance(entries, dict):
        raise SystemExit('%s has no "shortcuts" section' % path)
    return top, entries


def vdf_write(path, top):
    blob = vdf_serialize(list(top.items())) + b'\x08'
    st = os.stat(path)
    tmp = '%s.tmp-%d' % (path, os.getpid())
    with open(tmp, 'wb') as fh:
        fh.write(blob)
        fh.flush()
        os.fsync(fh.fileno())
    os.chmod(tmp, st.st_mode & 0o7777)
    try:
        os.chown(tmp, st.st_uid, st.st_gid)
    except OSError:
        pass
    os.replace(tmp, path)
    return blob


def quote(path):
    """The hand made shortcuts store these three fields with quotes around the
    path; Steam starts them like that, so copy it exactly."""
    return '"%s"' % path


def unquote(value):
    value = (value or '').strip()
    if len(value) > 1 and value.startswith('"') and value.endswith('"'):
        return value[1:-1]
    return value


# ------------------------------------------------------------- Steam collection
# Steam keeps its collections in userdata/<id>/config/cloudstorage/cloud-storage-namespace-<n>.json, a
# list of ["user-collections.<id>", {"key", "timestamp", "value", "version", ...}] whose value is the
# collection as JSON: {"id", "name", "added": [appid, ...], "removed": [...]}; a shortcut's appid is the
# unsigned 32-bit one of shortcuts.vdf. An entry written with the "union-collections" conflict
# resolution (as Steam ROM Manager writes them) is merged with Steam's cloud copy, not replaced by it.
# Steam must be stopped: it writes the whole file again when it exits.

def collection_file(vdf_path):
    """The cloud-storage file that holds the collections (namespace 1 unless another one has them)."""
    folder = os.path.join(os.path.dirname(vdf_path), 'cloudstorage')
    ns = 1
    try:
        with open(os.path.join(folder, 'cloud-storage-namespaces.json'), encoding='utf-8') as fh:
            for nid, _ in json.load(fh):
                try:
                    with open(os.path.join(folder, 'cloud-storage-namespace-%d.json' % int(nid)),
                              encoding='utf-8') as f2:
                        if '"user-collections.' in f2.read():
                            ns = int(nid)
                            break
                except OSError:
                    continue
    except (OSError, ValueError, TypeError):
        pass
    return os.path.join(folder, 'cloud-storage-namespace-%d.json' % ns)


def collection_read(path, name):
    """-> (file entries, index of the collection or None, the collection). The collection is found by
    its name (any case), so one made by hand in Steam is used too; else a new one is returned.
    An account that never had a collection may have no cloud-storage file yet: then the entries are an
    empty list, and collection_write makes the file. (None, None, None) when the file can't be used."""
    try:
        with open(path, encoding='utf-8') as fh:
            data = json.load(fh)
    except FileNotFoundError:
        data = []
    except ValueError as exc:
        print('  ! %s: %s -- collection left alone' % (path, exc))
        return None, None, None
    if not isinstance(data, list):
        return None, None, None
    for i, item in enumerate(data):
        if not (isinstance(item, list) and len(item) == 2 and isinstance(item[1], dict)
                and str(item[0]).startswith('user-collections.')):
            continue
        if item[1].get('is_deleted') or not item[1].get('value'):
            continue
        try:
            coll = json.loads(item[1]['value'])
        except ValueError:
            continue
        if isinstance(coll, dict) and str(coll.get('name', '')).strip().upper() == name.strip().upper():
            coll['added'] = [int(a) for a in coll.get('added') or []]
            coll['removed'] = [int(a) for a in coll.get('removed') or []]
            return data, i, coll
    cid = 'bc250-' + ''.join('%02x' % b for b in hashlib.md5(name.encode('utf-8')).digest()[:6])
    return data, None, {'id': cid, 'name': name, 'added': [], 'removed': []}


def collection_change(coll, want, drop):
    """-> (new collection, appids added, appids taken out): every appid of `want` in it, no appid of
    `drop`; nothing else of the collection is touched (games put in it by hand stay)."""
    want = [a for a in want if a not in drop]
    added = [a for a in coll['added'] if a not in drop]
    plus = [a for a in want if a not in added]
    minus = [a for a in coll['added'] if a in drop]
    new = dict(coll, added=added + plus, removed=[a for a in coll['removed'] if a not in want])
    return new, plus, minus


def namespace_register(path):
    """Make the cloud-storage folder and list the namespace of `path` in cloud-storage-namespaces.json
    (a list of [namespace, version]), for an account whose Steam made neither yet. Version "0": nothing of
    it synced, so Steam merges its cloud copy in when it starts (the entry is union-collections)."""
    folder = os.path.dirname(path)
    os.makedirs(folder, exist_ok=True)
    m = re.search(r'cloud-storage-namespace-(\d+)\.json$', path)
    if not m:
        return
    ns = int(m.group(1))
    reg = os.path.join(folder, 'cloud-storage-namespaces.json')
    try:
        with open(reg, encoding='utf-8') as fh:
            known = json.load(fh)
        if not isinstance(known, list):
            return                                  # a format we don't know: leave it to Steam
    except FileNotFoundError:
        known = []
    except ValueError:
        return
    if any(isinstance(k, list) and k and str(k[0]) == str(ns) for k in known):
        return
    known.append([ns, '0'])
    with open(reg + '.tmp', 'w', encoding='utf-8') as fh:
        json.dump(known, fh, separators=(',', ':'))
    os.replace(reg + '.tmp', reg)


def collection_write(path, data, index, coll):
    """Write the collection into the cloud-storage file (a copy of the old file next to it)."""
    now = int(time.time())
    key = 'user-collections.%s' % coll['id']
    entry = [key, {'key': key, 'timestamp': now,
                   'value': json.dumps(coll, separators=(',', ':'), ensure_ascii=False),
                   'version': str(now), 'conflictResolutionMethod': 'custom',
                   'strMethodId': 'union-collections'}]
    if os.path.exists(path):
        shutil.copy2(path, '%s.bak-%s' % (path, time.strftime('%Y-%m-%d-%H%M%S')))
    else:
        namespace_register(path)
    if index is None:
        data.append(entry)
    else:
        data[index] = entry
    tmp = path + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as fh:
        json.dump(data, fh, separators=(',', ':'), ensure_ascii=False)
    os.replace(tmp, path)


# ----------------------------------------------------------- its own shortcut
# The script adds a shortcut that starts itself (--from-steam), so it can be run from Big Picture /
# Gaming Mode. Steam has to be stopped to write shortcuts.vdf, which would stop a child of Steam too:
# started from Steam, the script runs again in a systemd user unit of its own and returns at once.
# Once added, a marker remembers it: a shortcut the user deleted is only added again with --add-self.

SELF_OPTION = '--from-steam'


def self_marker(tool, account):
    """One per Steam account: each account has its own shortcut list."""
    state = os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'), '.local/state')
    return os.path.join(state, tool, 'steam-shortcut-added-%s' % account)


def self_mark(tool, account):
    path = self_marker(tool, account)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'w') as fh:
            fh.write(time.strftime('%Y-%m-%d %H:%M:%S\n'))
    except OSError:
        pass


def steam_lock():
    """One sync script at a time: kytyps5-steam-sync and lichii-steam-sync both rewrite Steam's
    shortcut list and collections (their user units start together at login). Held until exit."""
    import fcntl
    state = os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'), '.local/state')
    os.makedirs(state, exist_ok=True)
    fh = open(os.path.join(state, 'bc250-steam-sync.lock'), 'w')
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print('waiting for the other Steam sync script to finish ...', flush=True)
        fcntl.flock(fh, fcntl.LOCK_EX)
    return fh


def forget_self_play(vdf_path, tool):
    """Keep this script's own shortcut off Steam's "Recent games": clear its last-played time in
    shortcuts.vdf and drop it from RecentLocalPlayedGameIDs in localconfig.vdf (16-byte records:
    the 64-bit game id, a shortcut's being appid << 32 | 0x02000000, then the time). Only while
    Steam is stopped: Steam writes both files when it exits."""
    try:
        top = vdf_read(vdf_path)
        top = top[0] if isinstance(top, tuple) else top
        ids = set()
        for e in top['shortcuts'].values():
            if is_self_entry(e, tool):
                ids.add(int(e.get('appid', 0)) & 0xffffffff)
                if e.get('LastPlayTime'):
                    e['LastPlayTime'] = 0
                    vdf_write(vdf_path, top)
        path = os.path.join(os.path.dirname(vdf_path), 'localconfig.vdf')
        if not ids or not os.path.isfile(path):
            return
        with open(path, encoding='utf-8') as fh:
            text = fh.read()
        m = re.search(r'"RecentLocalPlayedGameIDs"\s+"([0-9a-fA-F]*)"', text)
        if not m or len(m.group(1)) % 32:
            return
        raw = bytes.fromhex(m.group(1))
        recs = [raw[i:i + 16] for i in range(0, len(raw), 16)]
        keep = [r for r in recs if struct.unpack('<Q', r[:8])[0] not in
                {a << 32 | 0x02000000 for a in ids}]
        if len(keep) == len(recs):
            return
        tmp = path + '.tmp-%d' % os.getpid()
        with open(tmp, 'w', encoding='utf-8') as fh:
            fh.write(text[:m.start(1)] + b''.join(keep).hex() + text[m.end(1):])
        shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except (OSError, ValueError, KeyError, SystemExit) as exc:
        print('  ! could not take %r off "Recent games": %s' % (tool, exc))


def self_seed():
    """Per machine and user: Steam knows the shortcuts of all machines of an account (to stream them),
    and gives a shortcut whose id another machine already uses a new id, which the collection then lacks."""
    try:
        with open('/etc/machine-id') as fh:
            mid = fh.read().strip()
    except OSError:
        mid = os.uname().nodename
    return '%s %s' % (mid, os.path.expanduser('~'))


def self_exe(tool):
    """The script as Steam should start it: /usr/bin/<tool> when installed, else this file."""
    installed = shutil.which(tool)
    here = os.path.realpath(sys.argv[0])
    return installed if installed and os.path.realpath(installed) == here else here


def is_self_entry(entry, tool):
    exe = entry.get('exe', '')
    exe = exe[1:-1] if len(exe) > 1 and exe[0] == exe[-1] == '"' else exe
    return os.path.basename(exe) == tool and SELF_OPTION in entry.get('LaunchOptions', '')


def self_fields(tool, name):
    """The fields that make the shortcut what it is (others stay as the user set them)."""
    return {'appname': name, 'exe': '"%s"' % self_exe(tool),
            'StartDir': '"%s"' % os.path.expanduser('~'), 'LaunchOptions': SELF_OPTION}


def self_entry(appid, tool, name):
    e = collections.OrderedDict()
    e['appid'] = appid - 0x100000000 if appid >= 0x80000000 else appid
    f = self_fields(tool, name)
    e['appname'] = f['appname']
    e['exe'] = f['exe']
    e['StartDir'] = f['StartDir']
    e['icon'] = ''
    e['ShortcutPath'] = ''
    e['LaunchOptions'] = f['LaunchOptions']
    e['IsHidden'] = 0
    e['AllowDesktopConfig'] = 1
    e['AllowOverlay'] = 1
    e['OpenVR'] = 0
    e['Devkit'] = 0
    e['DevkitGameID'] = ''
    e['DevkitOverrideAppID'] = 0
    e['LastPlayTime'] = 0
    e['FlatpakAppID'] = ''
    e['sortas'] = ''
    e['tags'] = collections.OrderedDict()
    return e


def detach_from_steam(tool, argv, extra=()):
    """Started by Steam: run this script again, without --from-steam, in the user unit <tool>.service
    (outside Steam's process tree, so stopping Steam doesn't stop it). Its output: journalctl --user
    -u <tool>. Returns only when already detached."""
    if os.environ.get('BC250_SYNC_DETACHED'):
        return
    cmd = ['systemd-run', '--user', '--collect', '--quiet', '--unit=%s' % tool,
           '-E', 'BC250_SYNC_DETACHED=1']
    for name in ('HOME', 'DISPLAY', 'WAYLAND_DISPLAY', 'XAUTHORITY', 'XDG_RUNTIME_DIR',
                 'DBUS_SESSION_BUS_ADDRESS'):
        if os.environ.get(name):
            cmd += ['-E', '%s=%s' % (name, os.environ[name])]
    subprocess.run(['systemctl', '--user', 'reset-failed', tool + '.service'],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    args = [a for a in argv if a != SELF_OPTION] + list(extra)
    os.execvp('systemd-run', cmd + [sys.executable, os.path.realpath(sys.argv[0])] + args)


# ------------------------------------------------------------------------ steam
def steam_roots():
    home = os.path.expanduser('~')
    cands = []
    if os.environ.get('STEAM_PATH'):
        cands.append(os.environ['STEAM_PATH'])
    cands += [os.path.join(home, '.local/share/Steam'),
              os.path.join(home, '.steam/root'),
              os.path.join(home, '.steam/debian-installation')]
    # On SteamOS these are one and the same install reached by different names;
    # keep the real path, it is what the shortcuts' own icon paths already use.
    seen, out = set(), []
    for cand in cands:
        real = os.path.realpath(cand)
        if os.path.isdir(real) and real not in seen:
            seen.add(real)
            out.append(real)
    return out


def active_steam_user(root):
    """userdata id of the account Steam logs into: MostRecent "1" in config/loginusers.vdf, else the
    newest login timestamp (Steam leaves MostRecent out with one account). None if unknown."""
    try:
        with open(os.path.join(root, 'config', 'loginusers.vdf'), encoding='utf-8', errors='replace') as fh:
            text = fh.read()
    except OSError:
        return None
    best = None
    for m in re.finditer(r'"(\d{17})"\s*\{(.*?)\}', text, re.S):
        body = m.group(2)
        recent = re.search(r'"mostrecent"\s*"1"', body, re.I) is not None
        ts = re.search(r'"timestamp"\s*"(\d+)"', body, re.I)
        key = (recent, int(ts.group(1)) if ts else 0)
        if best is None or key > best[0]:
            best = (key, str(int(m.group(1)) - 76561197960265728))
    return best[1] if best else None


def find_shortcuts_vdf(want_user=None, create=True):
    """-> (userdata id, path): the account Steam logs into, else (several accounts, none known as
    active) the one with the longest list."""
    if not want_user:
        for root in steam_roots():
            active = active_steam_user(root)
            if active and os.path.isdir(os.path.join(root, 'userdata', active, 'config')):
                want_user = active
                break
    scored = []
    for root in steam_roots():
        ud = os.path.join(root, 'userdata')
        for user in sorted(os.listdir(ud)) if os.path.isdir(ud) else []:
            if want_user and user != want_user:
                continue
            path = os.path.join(ud, user, 'config/shortcuts.vdf')
            if not os.path.isfile(path):
                continue
            try:
                _, entries = vdf_read(path)
            except SystemExit as exc:
                print('  ! %s' % exc)
                continue
            scored.append((len(entries), os.path.getmtime(path), user, path))
    if not scored:
        # No non-Steam shortcut was ever added, so Steam has not written shortcuts.vdf
        # yet: start an empty one for the account that used Steam last (newest
        # localconfig.vdf). An existing file that can't be read is never replaced.
        newest = None
        for root in steam_roots():
            ud = os.path.join(root, 'userdata')
            for user in sorted(os.listdir(ud)) if os.path.isdir(ud) else []:
                if (want_user and user != want_user) or not user.isdigit() or user == '0':
                    continue
                conf = os.path.join(ud, user, 'config')
                lc = os.path.join(conf, 'localconfig.vdf')
                if os.path.isfile(lc) and not os.path.exists(os.path.join(conf, 'shortcuts.vdf')):
                    if newest is None or os.path.getmtime(lc) > newest[0]:
                        newest = (os.path.getmtime(lc), user, os.path.join(conf, 'shortcuts.vdf'))
        if newest:
            if create:
                with open(newest[2], 'wb') as fh:
                    fh.write(EMPTY_VDF)
                print('no shortcuts.vdf yet, started an empty one: %s' % newest[2])
            else:
                print('no shortcuts.vdf yet, a real run starts an empty one: %s' % newest[2])
            return newest[1], newest[2]
        raise SystemExit('no usable shortcuts.vdf under %s -- is Steam installed?'
                         % (', '.join(steam_roots()) or '~/.local/share/Steam'))
    scored.sort(reverse=True)
    return scored[0][2], scored[0][3]


def _run(cmd, timeout=30):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ''


def steam_unit_active():
    """True when Steam runs as the gamescope session's steam-launcher.service."""
    return _run(['systemctl', '--user', 'is-active', STEAM_UNIT]) == 'active'


def steam_processes():
    """This user's Steam client processes (a desktop Steam has no unit)."""
    pids = []
    for name in ('steam', 'steamwebhelper'):
        for pid in _run(['pgrep', '-x', name]).split():
            try:
                if os.stat('/proc/%s' % pid).st_uid == os.getuid():
                    pids.append(pid)
            except OSError:
                continue
    return pids


def steam_is_running():
    return steam_unit_active() or bool(steam_processes())


def steam_stop(wait=60):
    """-> how to start it again ('unit', 'desktop') or None when it did not stop."""
    how = 'unit' if steam_unit_active() else 'desktop'
    if how == 'unit':
        # Masked, like kytyps5-run does: the PS5 Gaming Mode session then waits for Steam to come
        # back instead of ending (steam_start unmasks it).
        _run(['systemctl', '--user', 'mask', '--runtime', STEAM_UNIT])
        _run(['systemctl', '--user', 'stop', STEAM_UNIT], timeout=wait)
    else:
        steam = shutil.which('steam')
        if steam:
            subprocess.Popen([steam, '-shutdown'], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    deadline = time.time() + wait
    while time.time() < deadline:
        if not steam_is_running():
            return how
        time.sleep(1)
    return None if steam_is_running() else how


def steam_start(how):
    if how == 'unit':
        # kytyps5-run masks the unit while a game runs, so unmask before starting.
        _run(['systemctl', '--user', 'unmask', '--runtime', STEAM_UNIT])
        _run(['systemctl', '--user', 'start', STEAM_UNIT])
        return
    steam = shutil.which('steam')
    if steam:
        subprocess.Popen([steam], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def appid_for(appname, exe, startdir, lo, taken):
    """A fresh id in the shape Steam gives its shortcuts (bit 31 set). Should
    Steam hand the shortcut another id when it first reads the list, the next run
    takes the id out of the list again and moves the artwork to match."""
    seed = '\x1f'.join((appname, exe, startdir, lo)).encode('utf-8', 'surrogateescape')
    x = int.from_bytes(hashlib.md5(seed).digest()[:4], 'big')
    x = ((x >> 15) | (x << 17)) & 0xffffffff
    x = (x >> 1) | 0x80000000
    while x in taken:
        x = ((x + 1) & 0x7fffffff) | 0x80000000
    taken.add(x)
    return x


# ------------------------------------------------------------------- game folder
def image_size(path):
    """(w, h) from the file header alone; None when we cannot tell."""
    try:
        with open(path, 'rb') as fh:
            head = fh.read(32)
    except OSError:
        return None
    try:
        if head[:8] == b'\x89PNG\r\n\x1a\n':
            return struct.unpack('>II', head[16:24])
        if head[:4] == b'DDS ':                       # 12 height, 16 width
            h, w = struct.unpack('<II', head[12:20])
            return w, h
        if head[:2] == b'\xff\xd8':                   # jpeg: walk the segments
            with open(path, 'rb') as fh:
                fh.read(2)
                while True:
                    marker = fh.read(2)
                    if len(marker) < 2 or marker[0] != 0xFF:
                        return None
                    if 0xC0 <= marker[1] <= 0xCF and marker[1] not in (0xC4, 0xC8, 0xCC):
                        fh.read(3)
                        h, w = struct.unpack('>HH', fh.read(4))
                        return w, h
                    fh.seek(struct.unpack('>H', fh.read(2))[0] - 2, os.SEEK_CUR)
    except (OSError, struct.error, ValueError):
        return None
    return None


def install_image(src, dst):
    """Byte copy when the game's own picture already is a picture Steam reads; a
    .dds goes through Pillow, which the board has (and keeps the copy honest:
    the ASTRO BOT artwork in the grid folder is a byte copy of the game's pic0)."""
    if not src.lower().endswith('.dds'):
        shutil.copyfile(src, dst)
        return 'copied'
    from PIL import Image
    im = Image.open(src)
    im.load()
    if im.mode not in ('RGB', 'RGBA', 'L'):
        im = im.convert('RGBA')
    tmp = dst + '.tmp'
    im.save(tmp, 'PNG')
    os.replace(tmp, dst)
    return 'converted'


def is_zar(path):
    return path.lower().endswith('.zar') and os.path.isfile(path)


def game_present(path):
    """A shortcut's game is still there: its folder, or its .zar."""
    return bool(path) and (os.path.isdir(path) or is_zar(path))


_gamefs = None


def gamefs():
    """Kyty's ZArchive reader, loaded from its file (it needs only the standard library)."""
    global _gamefs
    if _gamefs is None:
        import importlib.machinery
        import importlib.util
        loader = importlib.machinery.SourceFileLoader('kyty_gamefs', GAMEFS)
        spec = importlib.util.spec_from_loader('kyty_gamefs', loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        _gamefs = mod
    return _gamefs


def zar_meta(zar):
    """Read the game's sce_sys/param.json and pictures out of a .zar into a cache folder
    (~/.cache/kytyps5-steam-sync/<archive name>-<hash of its path>) and return that folder,
    with has_eboot. The game root inside the archive is found the way Kyty finds it: the
    shallowest eboot.bin with sce_sys/param.json beside it. Read again only when the
    archive's size or time changed. -> (folder or None, has_eboot)"""
    real = os.path.realpath(zar)
    st = os.stat(real)
    stamp = '%d %d' % (st.st_size, st.st_mtime_ns)
    base = os.environ.get('XDG_CACHE_HOME') or os.path.expanduser('~/.cache')
    folder = os.path.join(base, 'kytyps5-steam-sync', '%s-%s' % (
        os.path.basename(real)[:-4], hashlib.md5(real.encode('utf-8', 'surrogateescape')).hexdigest()[:8]))
    stamp_file = os.path.join(folder, '.stamp')
    try:
        with open(stamp_file) as fh:
            old = fh.read().split('\n')
        if old[0] == stamp:
            return folder, old[1:2] == ['eboot']
    except OSError:
        pass
    try:
        archive = gamefs().Zar(real)
    except Exception as exc:                       # noqa: BLE001 - a broken archive is skipped, not fatal
        print('  ! %s: cannot read the archive (%s: %s)' % (zar, type(exc).__name__, exc))
        return None, False
    try:
        files = [p for p, is_file in archive.paths() if is_file]
        boots = sorted((p for p in files if p.rsplit('/', 1)[-1].lower() == 'eboot.bin'),
                       key=lambda p: p.count('/'))
        prefix = None
        for b in boots:
            pre = b.rsplit('/', 1)[0] + '/' if '/' in b else ''
            if archive.lookup(pre + 'sce_sys/param.json'):
                prefix = pre
                break
        if prefix is None:                           # no game root: use the top level, if anything is there
            prefix = ''
        if os.path.isdir(folder):
            shutil.rmtree(folder)
        os.makedirs(os.path.join(folder, 'sce_sys'))
        for p in files:
            if not p.startswith(prefix + 'sce_sys/') or '/' in p[len(prefix + 'sce_sys/'):]:
                continue
            name = p.rsplit('/', 1)[-1]
            if META_RE.match(name):
                with open(os.path.join(folder, 'sce_sys', name), 'wb') as fh:
                    fh.write(archive.read_node(archive.lookup(p)[0]))
        has_eboot = bool(archive.lookup(prefix + 'eboot.bin'))
    except Exception as exc:                       # noqa: BLE001
        print('  ! %s: cannot read the archive (%s: %s)' % (zar, type(exc).__name__, exc))
        return None, False
    finally:
        archive.close()
    with open(stamp_file, 'w') as fh:
        fh.write(stamp + ('\neboot' if has_eboot else '\n'))
    return folder, has_eboot


class Game(object):
    """One PS5 game: a folder, or a ZArchive (.zar) of one. Its name and its art come
    from what is inside it; for a .zar they are read out of it into a cache folder (root)."""

    def __init__(self, path, lang=None):
        self.dir = path
        self.path = os.path.realpath(path)
        self.zar = is_zar(path)
        name = os.path.basename(self.path)
        self.title_id = name[:-4] if self.zar else name
        self.root, self.has_eboot = zar_meta(path) if self.zar else (path, None)
        self.param = self._param()
        self.lang, self.title = self._title(lang)

    def start_dir(self):
        """Steam's StartDir: the folder (for a .zar, the folder it lies in)."""
        return os.path.dirname(self.dir) if self.zar else self.dir

    def _param(self):
        if not self.root:
            return {}
        p = os.path.join(self.root, 'sce_sys/param.json')
        if os.path.isfile(p):
            try:
                with open(p, encoding='utf-8', errors='replace') as fh:
                    return json.load(fh)
            except ValueError as exc:
                print('  ! %s: %s' % (p, exc))
        return {}

    def _title(self, lang):
        loc = self.param.get('localizedParameters') or {}
        for try_lang in [lang, os.environ.get('LANGUAGE', '').split(':')[0],
                         os.environ.get('LC_ALL', '').split('.')[0],
                         PREFERRED_LANG] + list(loc):
            if try_lang and isinstance(loc.get(try_lang), dict) and loc[try_lang].get('titleName'):
                return try_lang, loc[try_lang]['titleName'].strip()
        if self.param.get('titleId'):
            return None, self.param['titleId']
        return None, re.sub(r'-app\d*$', '', self.title_id) or self.title_id

    def appname(self, suffix):
        return (self.title + suffix)[:120]

    def looks_installed(self):
        if self.zar:
            return bool(self.param) or bool(self.has_eboot)
        return bool(self.param) or os.path.isfile(os.path.join(self.dir, 'eboot.bin'))

    def images(self):
        """(icon, landscape, portrait) inside the game folder, any of them None."""
        if getattr(self, '_images', None) is not None:
            return self._images
        found = []
        for sub in ('sce_sys', '.'):
            if not self.root:
                break
            d = os.path.join(self.root, sub)
            if os.path.isdir(d):
                found += [os.path.join(d, f) for f in sorted(os.listdir(d))
                          if re.match(r'(?i)^(icon0|pic0|pic1|pic2)\.(png|jpg|jpeg|webp|dds)$', f)]
        icon = pick_image(found, r'/icon0\.')
        landscape = pick_image(found, r'/pic0\.')
        portrait = pick_image(found, r'/pic1\.')
        size = image_size(portrait) if portrait else None
        if portrait and not (size and size[1] > size[0]):
            portrait = None            # a pic1 that is not vertical is just more wallpaper
        self._images = (icon, landscape, portrait)
        return self._images


def pick_image(paths, pattern):
    """Prefer a picture Steam reads directly over a .dds that has to be converted."""
    hits = [p for p in paths if re.search(pattern, p)]
    for ext in ('.png', '.jpg', '.jpeg', '.webp', '.dds'):
        for p in hits:
            if p.lower().endswith(ext):
                return p
    return hits[0] if hits else None


def md5(path):
    h = hashlib.md5()
    try:
        with open(path, 'rb') as fh:
            for chunk in iter(lambda: fh.read(1 << 20), b''):
                h.update(chunk)
    except OSError:
        return None
    return h.hexdigest()


def art_wanted(appid, game):
    """[(source, grid file name)] like the ASTRO BOT entry: pic0 for the grid and
    the hero, icon0 for the icon and (when the game has no vertical art) the poster."""
    icon, landscape, portrait = game.images()
    want = []
    if landscape:
        want += [(landscape, ART_NAMES[0] % appid), (landscape, ART_NAMES[1] % appid)]
    if icon:
        want.append((icon, ART_NAMES[2] % appid))
    poster = portrait or icon
    if poster:
        want.append((poster, ART_NAMES[3] % appid))
    return want


def shortcut_icon(appid, grid_dir, game):
    """Where this shortcut's icon lives once the game's own icon0 is copied, or
    None when the game has no icon to copy -- then the icon field is left alone,
    it may point at a picture the owner put there by hand."""
    name = ART_NAMES[2] % appid
    if not any(n == name for _, n in art_wanted(appid, game)):
        return None
    return os.path.join(grid_dir, name)


def sync_art(appid, game, grid_dir, state, force=False, say=print):
    """Put this game's pictures in Steam's grid folder under its current appid and
    remove the ones this script made for an older appid of the same shortcut.
    -> (kept, written, removed, missing sources)"""
    keep, written, removed = [], [], []
    rec = state.get(game.path) or {}
    want = art_wanted(appid, game)
    if not want:
        return keep, written, removed, True
    sources = {}
    for src, name in want:
        dst = os.path.join(grid_dir, name)
        src_sum = md5(src)
        sources[name] = src_sum
        # content decides: art the owner placed by hand in exactly this shape (the
        # ASTRO BOT case) is adopted, and a picture converted from a .dds is kept
        # as long as its source has not changed
        if not force and os.path.isfile(dst) and (
                md5(dst) == src_sum or (rec.get('sources') or {}).get(name) == src_sum):
            keep.append(name)
            continue
        try:
            how = install_image(src, dst)
        except Exception as exc:
            say('    ! %s: %s (%s)' % (name, type(exc).__name__, exc))
            continue
        written.append((how, name, os.path.relpath(src, game.root) if not game.zar
                        else os.path.basename(game.dir) + ':sce_sys/' + os.path.basename(src)))
        keep.append(name)
    made = set(rec.get('files') or [])
    if rec.get('appid'):
        made |= {name % rec['appid'] for name in ART_NAMES}
    for name in sorted(made - set(keep)):
        path = os.path.join(grid_dir, name)
        if os.path.isfile(path) or os.path.islink(path):
            os.remove(path)
            removed.append(name)
    state[game.path] = {'appid': appid, 'title': game.title, 'files': sorted(set(keep)),
                        'sources': {n: sources[n] for n in sorted(set(keep)) if n in sources}}
    for how, name, src in written:
        say('    %s %s <- %s' % (how, name, src))
    if removed:
        say('    removed stale %s' % ', '.join(removed))
    return keep, written, removed, False


def forget_art(game_path, appid, grid_dir, state, say=print):
    """Delete the grid files of a shortcut that goes away: the ones this script
    made for it, or, for a shortcut it has no record of, the standard artwork
    names of that shortcut's appid (no other shortcut uses that appid)."""
    rec = state.pop(game_path, None) or {}
    names = set(rec.get('files') or []) or {name % appid for name in ART_NAMES}
    if rec.get('appid'):
        names |= {name % rec['appid'] for name in ART_NAMES}
    full64 = ((appid << 32) | 0x02000000) & 0xFFFFFFFFFFFFFFFF
    for name in sorted(names):
        path = os.path.join(grid_dir, name)
        if os.path.isfile(path) or os.path.islink(path):
            os.remove(path)
            say('    - %s' % name)
    link = os.path.join(grid_dir, '%d.png' % full64)
    if os.path.islink(link):
        os.remove(link)
        say('    - %s (symlink)' % os.path.basename(link))


# ---------------------------------------------------------------- the shortcuts
def entry_appid(entry):
    return int(entry.get('appid', 0)) & 0xffffffff


def is_kyty_entry(entry):
    return os.path.basename(unquote(entry.get('exe', ''))) in RUNNER_NAMES


def entry_game_path(entry):
    """The game folder (or .zar) a kytyps5-run shortcut starts, out of its launch options.
    Split as they are: shlex takes the quotes off a path with spaces in it."""
    lo = entry.get('LaunchOptions', '') or ''
    try:
        toks = shlex.split(lo)
    except ValueError:
        toks = lo.split()
    for tok in toks:
        if tok.startswith(('/', '~', '.')) or tok.lower().endswith('.zar'):
            return os.path.abspath(os.path.expanduser(tok))
    return None


def moved_options(entry, game):
    """The shortcut's launch options with its game path replaced by game's (the rest, such as
    --keep-steam or --console-language, stays as it was)."""
    lo = entry.get('LaunchOptions', '') or ''
    try:
        toks = shlex.split(lo)
    except ValueError:
        toks = lo.split()
    out, done = [], False
    for tok in toks:
        if not done and (tok.startswith(('/', '~', '.')) or tok.lower().endswith('.zar')):
            out.append(quote(game.dir))
            done = True
        else:
            out.append(shlex.quote(tok))
    return ' '.join(out) if done else quote(game.dir) + (' ' + ' '.join(out) if out else '')


def zar_addcont(game):
    """A .zar's add-on packages: the addcont folder of the folder beside it that is named as the
    archive without .zar (PPSA26344-app0/addcont next to PPSA26344-app0.zar), else None. A game
    folder's own addcont needs no option: kytyps5-run finds it there."""
    if not game.zar:
        return None
    folder = os.path.join(game.dir[:-4], 'addcont')
    return folder if os.path.isdir(folder) else None


def with_addcont(lo, game):
    """Launch options lo with --addcont-dir=<folder> as zar_addcont(game) wants it: added, changed
    or taken out. lo itself when it is right already, so a shortcut is only rewritten for a change."""
    try:
        toks = shlex.split(lo)
    except ValueError:
        toks = lo.split()
    folder = zar_addcont(game)
    want = ['--addcont-dir=' + folder] if folder else []
    if [t for t in toks if t.startswith('--addcont-dir=')] == want:
        return lo
    out = []
    for tok in toks:
        if tok.startswith('--addcont-dir='):
            continue
        if tok.startswith(('/', '~', '.')) or tok.lower().endswith('.zar'):
            out.append(quote(os.path.abspath(os.path.expanduser(tok))))
        else:
            out.append(shlex.quote(tok))
    out += [quote(w) for w in want]
    return ' '.join(out)


def new_entry(appid, appname, runner, game_path, keep_steam, icon_path, start_dir=None):
    """Same fields in the same order as the hand made ASTRO BOT shortcut."""
    e = collections.OrderedDict()
    e['appid'] = appid - 0x100000000 if appid >= 0x80000000 else appid
    e['appname'] = appname
    e['exe'] = quote(runner)
    e['StartDir'] = quote(start_dir or game_path)
    e['icon'] = icon_path
    e['ShortcutPath'] = ''
    e['LaunchOptions'] = quote(game_path) + (' --keep-steam' if keep_steam else '')
    e['IsHidden'] = 0
    e['AllowDesktopConfig'] = 1
    e['AllowOverlay'] = 1
    e['OpenVR'] = 0
    e['Devkit'] = 0
    e['DevkitGameID'] = ''
    e['DevkitOverrideAppID'] = 0
    e['LastPlayTime'] = 0
    e['FlatpakAppID'] = ''
    e['sortas'] = ''
    e['tags'] = collections.OrderedDict()
    return e


def addcont_dir():
    return os.path.join(os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config'),
                        'KytyPS5-Native', 'addcont')


def addcont_missing(game, folder):
    """(title id, file, labels it still lacks) for a game in ADDCONT, else None.
    The folder name decides; the game's files are not looked at."""
    name = os.path.basename(game.dir)
    title = next((t for t in ADDCONT if t in name), None)
    if not title:
        return None
    path = os.path.join(folder, title)
    have = set()
    try:
        with open(path, encoding='utf-8', errors='replace') as fh:
            for line in fh:
                line = line.split('#', 1)[0].strip()
                if line:
                    have.add(line.split('=', 1)[0].strip())
    except OSError:
        pass
    return title, path, [l for l in ADDCONT[title] if l not in have]


def add_addcont(path, labels):
    """Append labels to an addcont file, keeping what is in it."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        with open(path, 'rb') as fh:
            old = fh.read()
    except OSError:
        old = b''
    with open(path, 'a', encoding='utf-8') as fh:
        if old and not old.endswith(b'\n'):
            fh.write('\n')
        fh.write(''.join(l + '\n' for l in labels))


def ask(text, default=False, tty=True):
    if not tty:
        print('%s  [no terminal here -> %s]' % (text, 'yes' if default else 'no'))
        return default
    reply = input('%s  [%s] ' % (text, 'Y/n' if default else 'y/N')).strip().lower()
    return default if not reply else reply in ('y', 'yes')


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog='kytyps5-steam-sync', description='Add the PS5 games of a folder to Steam as '
        'KytyPS5-Native shortcuts, with the name and the artwork of the game itself.',
        epilog=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('dir', nargs='?', default=DEFAULT_GAMES_DIR,
                    help='folder with one subfolder per game (default %s)' % DEFAULT_GAMES_DIR)
    ap.add_argument('--runner', default=DEFAULT_RUNNER,
                    help='the kytyps5-run to start through (default %s)' % DEFAULT_RUNNER)
    ap.add_argument('--lang', default=PREFERRED_LANG,
                    help='title language of param.json (default %s)' % PREFERRED_LANG)
    ap.add_argument('--name-suffix', default=GAME_SUFFIX,
                    help='behind the game name, like the ASTRO BOT entry (default "%s")' % GAME_SUFFIX)
    ap.add_argument('--steam-user', default=None, help='userdata id when Steam has several')
    ap.add_argument('--list', action='store_true', help='only show what is there and what differs')
    ap.add_argument('--dry-run', action='store_true', help='change nothing')
    ap.add_argument('--yes', '-y', action='store_true',
                    help='stop and restart a running Steam without asking')
    ap.add_argument('--prune', action='store_true',
                    help='remove the shortcuts (and their artwork) whose game folder is gone '
                    'without asking; without it you are asked for each one')
    ap.add_argument('--keep-steam', action='store_true',
                    help='add --keep-steam: Steam stays up while the game runs')
    ap.add_argument('--no-art', action='store_true', help='leave the artwork alone')
    ap.add_argument('--force-art', action='store_true', help='re-copy the artwork even when current')
    ap.add_argument('--art-only', action='store_true',
                    help='only re-copy artwork for the shortcuts that already exist')
    ap.add_argument('--no-restart', action='store_true', help='leave Steam stopped at the end')
    ap.add_argument('--collection', default=COLLECTION,
                    help='Steam collection with all KytyPS5 shortcuts (default %r)' % COLLECTION)
    ap.add_argument('--no-collection', action='store_true', help='leave Steam collections alone')
    ap.add_argument('--add-self', action='store_true',
                    help='only add (or repair) the %r shortcut that runs this script from Steam' % SELF_NAME)
    ap.add_argument(SELF_OPTION, dest='from_steam', action='store_true', help=argparse.SUPPRESS)
    ap.add_argument('--add-self-once', action='store_true', help=argparse.SUPPRESS)   # package hook
    ap.add_argument('--ensure-self', action='store_true',
                    help='like --add-self, but only while Steam is not running (the user unit that '
                         'runs before Steam starts)')
    args = ap.parse_args(argv)
    if args.from_steam:
        detach_from_steam(SELF_TOOL, sys.argv[1:] if argv is None else list(argv), ['--yes', '--prune'])

    lock = steam_lock()                      # noqa: F841 (held until exit)
    games_dir = os.path.abspath(os.path.expanduser(args.dir))
    if not os.path.isdir(games_dir) and (args.add_self or args.add_self_once or args.ensure_self):
        os.makedirs(games_dir, exist_ok=True)       # where the games go; the shortcut syncs it
    if not os.path.isdir(games_dir):
        raise SystemExit('no such folder: %s' % games_dir)
    runner = args.runner if os.path.isabs(args.runner) else shutil.which(args.runner)
    if not runner or not os.path.exists(runner):
        raise SystemExit('%s not found (install kytyps5-native-git, or pass --runner)' % args.runner)

    try:
        user, vdf_path = find_shortcuts_vdf(args.steam_user, create=not (args.dry_run or args.list))
    except SystemExit:
        if args.ensure_self or args.add_self_once:   # login unit / package hook before Steam's first login
            print('no Steam account yet: the shortcut is added at a login after Steam has been set up')
            return 0
        raise
    account = user
    if not (args.dry_run or args.list) and os.path.isfile(vdf_path) and not steam_is_running():
        forget_self_play(vdf_path, SELF_TOOL)
    if args.ensure_self:                         # the user unit, before Steam starts
        if steam_is_running():
            print('Steam is already running: the shortcut is checked at the next login')
            return 0
        args.add_self = True
    if args.add_self_once:                       # the package hook: once per Steam account
        if os.path.exists(self_marker(SELF_TOOL, account)):
            print('the Steam shortcut was added for account %s before: left alone' % account)
            return 0
        args.add_self = True
    grid_dir = os.path.join(os.path.dirname(vdf_path), 'grid')
    top, entries = vdf_read(vdf_path)
    # This script's own shortcut: added once (and with --add-self), see "its own shortcut" above.
    self_idx = next((k for k, e in entries.items() if isinstance(e, dict) and is_self_entry(e, SELF_TOOL)),
                    None)
    if self_idx is not None and not os.path.exists(self_marker(SELF_TOOL, account)) and not (args.dry_run or args.list):
        self_mark(SELF_TOOL, account)
    self_want = args.add_self or (self_idx is None and not os.path.exists(self_marker(SELF_TOOL, account)))
    self_set = self_fields(SELF_TOOL, SELF_NAME)
    need_self = self_want and (self_idx is None or
                               any(entries[self_idx].get(k) != v for k, v in self_set.items()))
    state = {}
    for name in (STATE_NAME,) + OLD_STATE_NAMES:
        try:
            with open(os.path.join(games_dir, name), encoding='utf-8') as fh:
                state = json.load(fh)
            break
        except (OSError, ValueError):
            continue

    games, skipped = [], []
    for name in sorted(os.listdir(games_dir)):
        path = os.path.join(games_dir, name)
        if name.startswith('.') or not (os.path.isdir(path) or is_zar(path)):
            continue
        game = Game(path, args.lang)
        if game.looks_installed():
            games.append(game)
        elif not (os.path.isdir(path) and is_zar(path + '.zar')):   # a .zar's add-on folder is no game
            skipped.append(name)

    if args.add_self:
        games, skipped = [], []                     # --add-self: only the own shortcut
    kyty = [(idx, e) for idx, e in entries.items()
            if isinstance(e, dict) and is_kyty_entry(e)]

    real_games_dir = os.path.realpath(games_dir)

    def inside(path):
        return bool(path) and any(path == d or path.startswith(d + os.sep)
                                  for d in (games_dir, real_games_dir))

    # A game folder may be a symlink (a game on another drive linked into the
    # games folder): match shortcuts by the folder they really start.
    by_path = collections.OrderedDict()
    for idx, e in kyty:
        if entry_game_path(e):
            by_path.setdefault(os.path.realpath(entry_game_path(e)), []).append((idx, e))
    todo = [g for g in games if not by_path.get(g.path)]
    known = [g for g in games if by_path.get(g.path)]
    matched = {id(e) for g in known for _, e in by_path[g.path]}
    gone = [(idx, e) for idx, e in kyty if id(e) not in matched
            and inside(entry_game_path(e)) and not game_present(entry_game_path(e))]
    elsewhere = [(idx, e) for idx, e in kyty if id(e) not in matched
                 and not inside(entry_game_path(e))]
    if args.add_self:
        gone, elsewhere = [], []

    # A game folder swapped for its .zar (or the .zar for the folder again): its shortcut moves along,
    # keeping its appid, play time and Steam settings (Steam Input off), instead of a new one.
    moves = []
    for g in list(todo):
        other = g.path[:-4] if g.zar else g.path + '.zar'
        row = next((r for r in gone if os.path.realpath(entry_game_path(r[1])) == other), None)
        if row:
            moves.append((row[0], row[1], g))
            gone.remove(row)
            todo.remove(g)
            known.append(g)
            by_path[g.path] = [row]

    print('games   %s (%d game folder%s)' % (games_dir, len(games), '' if len(games) == 1 else 's'))
    print('steam   %s (userdata %s, %d shortcut%s)'
          % (vdf_path, user, len(entries), '' if len(entries) == 1 else 's'))
    print('art     %s' % grid_dir)
    for g in known:
        entry = by_path[g.path][0][1]
        note = '' if entry.get('appname') == g.appname(args.name_suffix) else \
            '  (Steam calls it %r)' % entry.get('appname')
        print('  = %-32s appid %-11d%s' % (g.appname(args.name_suffix)[:32],
                                           entry_appid(entry), note))
    for g in todo:
        print('  + %-32s %s' % (g.appname(args.name_suffix)[:32], g.dir))
    for idx, e, g in moves:
        print('  > %-32s moves to %s' % (e.get('appname', '')[:32], g.dir))
    for name in skipped:
        print('  ! %s: no sce_sys/param.json and no eboot.bin, skipped' % name)
    for idx, e in gone:
        print('  - %-32s its folder is gone: %s%s' % (e.get('appname', '')[:32], entry_game_path(e),
              ''))
    for idx, e in elsewhere:
        print('  . %-32s outside this folder, left alone: %s'
              % (e.get('appname', '')[:32], entry_game_path(e)))
    for path, rows in by_path.items():
        if len(rows) > 1:
            print('  ! %d shortcuts point at the same folder %s' % (len(rows), path))

    addcont = [a for a in (addcont_missing(g, addcont_dir()) for g in games) if a]
    for title, path, labels in addcont:
        if not labels:
            print('  a %s add-ons registered in %s' % (title, path))
        elif args.list or args.dry_run:
            print('  a %s add-ons to register in %s: %s' % (title, path, ' '.join(labels)))
        else:
            add_addcont(path, labels)
            print('  a %s add-ons registered in %s: %s' % (title, path, ' '.join(labels)))

    coll_path = coll = None
    if not args.no_collection and args.collection.strip():
        coll_path = collection_file(vdf_path)
        coll_data, coll_idx, coll = collection_read(coll_path, args.collection.strip())
        if coll is None:
            print('  ! no Steam cloud storage yet (%s): start Steam once, then run this again '
                  'for the %r collection' % (coll_path, args.collection))
        else:
            ids = [entry_appid(e) for _, e in kyty]
            have = sum(1 for a in ids if a in coll['added'])
            print('collection %r: %d of %d KytyPS5 shortcut%s in it%s'
                  % (coll['name'], have, len(ids), '' if len(ids) == 1 else 's',
                     '' if coll_idx is not None else ' (new collection)'))

    if args.list:
        return 0
    if not games and not gone and not need_self:
        print('\nno game folders here and no shortcut of them to clean up')
        return 0

    tty = sys.stdin.isatty()
    remove = []
    for idx, e in gone:
        if args.prune or ask('Remove the shortcut %r (its game folder is gone)?' % e.get('appname'),
                             default=False, tty=tty):
            remove.append((idx, e))

    drop_ids = {entry_appid(e) for _, e in remove}
    keep_ids = [entry_appid(e) for _, e in kyty if entry_appid(e) not in drop_ids]
    if self_idx is not None:
        keep_ids.append(entry_appid(entries[self_idx]))
    need_coll = False
    if coll is not None and not args.art_only:
        _, plus, minus = collection_change(coll, keep_ids, drop_ids)
        need_coll = bool(plus or minus or todo)

    # The artwork does not need Steam stopped, so it is done first: it decides
    # which icon file the shortcut has to name (and an icon field only changes
    # with the list, which does need Steam stopped).
    if not args.no_art and known and not args.dry_run:
        print('artwork')
        for g in known:
            idx, e = by_path[g.path][0]
            keep, written, removed, missing = sync_art(
                entry_appid(e), g, grid_dir, state, args.force_art)
            if missing:
                print('  %s: no pic0/icon0 in the game folder, nothing to copy' % g.title)
            else:
                print('  %s: %d copied, %d already there%s'
                      % (g.title, len(written), len(keep),
                         ', %d stale removed' % len(removed) if removed else ''))

    icon_fixes = []
    if not args.no_art:
        for g in known:
            idx, e = by_path[g.path][0]
            want = shortcut_icon(entry_appid(e), grid_dir, g)
            if want and e.get('icon') != want and (args.dry_run or os.path.isfile(want)):
                icon_fixes.append((idx, want))

    # A .zar's add-on folder beside it, in the launch options (or out again once that folder is gone).
    addcont_fixes = []
    for g in known:
        idx, e = by_path[g.path][0]
        want = with_addcont(e.get('LaunchOptions', '') or '', g)
        if want != (e.get('LaunchOptions', '') or ''):
            addcont_fixes.append((idx, e, want))

    # Without --add-self the own shortcut doesn't stop Steam by itself: it comes with the next change.
    need_self = need_self and (args.add_self or bool(todo or remove or icon_fixes or moves or addcont_fixes) or not steam_is_running())
    need_list = (bool(todo or remove or icon_fixes or moves or addcont_fixes) and not args.art_only) or need_self
    need_coll = need_coll or (need_self and coll is not None)
    if args.no_art and not need_list and not need_coll:
        print('\nnothing to do (--no-art, and nothing to add or remove)')
        return 0
    if not need_list and not need_coll and not (known and not args.no_art):
        print('\nnothing to do')
        return 0

    if args.dry_run:
        print('\ndry run, nothing written:')
        for g in todo:
            print('  + %r  %s %s' % (g.appname(args.name_suffix), runner,
                                     with_addcont(quote(g.dir) + (' --keep-steam' if args.keep_steam else ''), g)))
        for idx, e in remove:
            print('  - slot %s %r (appid %d) and its artwork' % (idx, e.get('appname'), entry_appid(e)))
        for idx, want in icon_fixes:
            print('  * slot %s icon -> %s' % (idx, want))
        for idx, e, g in moves:
            print('  > slot %s %r -> %s' % (idx, e.get('appname'), with_addcont(moved_options(e, g), g)))
        for idx, e, want in addcont_fixes:
            print('  a slot %s %r -> %s' % (idx, e.get('appname'), want))
        if need_self:
            print('  %s %r  %s %s' % ('*' if self_idx is not None else '+', SELF_NAME,
                                     self_set['exe'], SELF_OPTION))
        if not args.no_art:
            for g in known:
                print('  * art of %s into %s for appid %d'
                      % (g.dir, grid_dir, entry_appid(by_path[g.path][0][1])))
        if need_coll:
            _, plus, minus = collection_change(coll, keep_ids, drop_ids)
            print('  * collection %r: %d shortcut%s added%s, %d taken out'
                  % (coll['name'], len(plus) + len(todo), '' if len(plus) + len(todo) == 1 else 's',
                     ' (%d new)' % len(todo) if todo else '', len(minus)))
        return 0

    restart = None
    if (need_list or need_coll) and steam_is_running():
        if not args.yes:
            if not tty:
                raise SystemExit('\nSteam is running: close it and run this again, or use --yes '
                                 'to let this script stop Steam and start it again afterwards.')
            if not ask('Steam is running. Stop it, write the shortcut list and start it again?',
                       default=True, tty=tty):
                raise SystemExit('Steam was not stopped, nothing written')
        restart = steam_stop()
        if not restart:
            raise SystemExit('Steam did not stop within a minute, nothing written')

    try:
        taken = {entry_appid(e) for e in entries.values() if isinstance(e, dict)}
        new_apps = []
        self_new = None
        if need_self and self_idx is not None:
            entries[self_idx].update(self_set)
        elif need_self:
            self_new = appid_for(SELF_NAME, self_set['exe'], self_set['StartDir'],
                                 SELF_OPTION + ' ' + self_seed(), taken)
        if need_list:
            for idx, want in icon_fixes:
                entries[idx]['icon'] = want
            for idx, e, g in moves:
                old = os.path.realpath(entry_game_path(e))
                e['LaunchOptions'] = with_addcont(moved_options(e, g), g)
                e['StartDir'] = quote(g.start_dir())
                rec = state.pop(old, None)           # the artwork step may have recorded it under the new path
                if rec and g.path not in state:
                    state[g.path] = rec
            for idx, e, want in addcont_fixes:
                e['LaunchOptions'] = want
                print('  a %-32s %s' % (e.get('appname', '')[:32], want))
            for g in todo:
                lo = with_addcont(quote(g.dir) + (' --keep-steam' if args.keep_steam else ''), g)
                appid = appid_for(g.appname(args.name_suffix), quote(runner), quote(g.dir),
                                  lo, taken)
                if not args.no_art and not os.path.isdir(grid_dir):
                    os.makedirs(grid_dir, exist_ok=True)
                new_apps.append((g, appid, lo))
            numbered = collections.OrderedDict()
            dropped = {r[0] for r in remove}
            for idx, e in entries.items():
                if idx not in dropped:
                    numbered[str(len(numbered))] = e
            for g, appid, lo in new_apps:
                numbered[str(len(numbered))] = new_entry(
                    appid, g.appname(args.name_suffix), runner, g.dir, args.keep_steam,
                    shortcut_icon(appid, grid_dir, g) or '', g.start_dir())
                numbered[str(len(numbered) - 1)]['LaunchOptions'] = lo
            if self_new is not None:
                numbered[str(len(numbered))] = self_entry(self_new, SELF_TOOL, SELF_NAME)
            for g, appid, lo in new_apps:
                if not args.no_art:
                    sync_art(appid, g, grid_dir, state)
            for idx, e in remove:
                forget_art(os.path.realpath(entry_game_path(e)), entry_appid(e), grid_dir, state)
            backup = '%s.bak-%s' % (vdf_path, time.strftime('%Y-%m-%d-%H%M%S'))
            shutil.copy2(vdf_path, backup)
            top['shortcuts'] = numbered
            blob = vdf_write(vdf_path, top)
            if need_self:
                self_mark(SELF_TOOL, account)
                print('  %s %-32s %s %s' % ('*' if self_new is None else '+', SELF_NAME,
                                           self_set['exe'], SELF_OPTION))
            for g, appid, lo in new_apps:
                slot = next(k for k, v in numbered.items() if entry_appid(v) == appid)
                print('  + %-32s appid %-11d slot %s  %s %s'
                      % (g.appname(args.name_suffix)[:32], appid, slot, runner, lo))
            print('\nwrote %s: %d shortcut%s (%d added, %d removed, %d icon%s fixed)\n  backup %s'
                  % (vdf_path, len(numbered), '' if len(numbered) == 1 else 's',
                     len(new_apps) + (self_new is not None), len(remove), len(icon_fixes),
                     '' if len(icon_fixes) == 1 else 's', backup))
            if new_apps:
                print('\nRemember: in Steam, turn Steam Input OFF for these shortcuts -- with it')
                print('on, Kyty only sees Steam\'s virtual pad (no motion, haptics, adaptive triggers).')
        if need_coll:
            # Read again: Steam writes the file when it exits.
            data, idx, coll = collection_read(coll_path, coll['name'])
            if coll is not None:
                coll, plus, minus = collection_change(
                    coll, keep_ids + [appid for g, appid, lo in new_apps]
                    + ([self_new] if self_new is not None else []), drop_ids)
                if plus or minus:
                    collection_write(coll_path, data, idx, coll)
                    print('collection %r: %d added, %d taken out (%d in it)'
                          % (coll['name'], len(plus), len(minus), len(coll['added'])))
        try:
            with open(os.path.join(games_dir, STATE_NAME), 'w', encoding='utf-8') as fh:
                json.dump(state, fh, indent=1, sort_keys=True)
            for name in OLD_STATE_NAMES:
                old = os.path.join(games_dir, name)
                if os.path.isfile(old):
                    os.remove(old)
        except OSError as exc:
            print('  ! could not save %s in %s: %s' % (STATE_NAME, games_dir, exc))
    finally:
        if restart:
            forget_self_play(vdf_path, SELF_TOOL)   # Steam is stopped here
        if restart:
            if args.no_restart:
                print('Steam is left stopped (start it when you like)')
            else:
                steam_start(restart)
                print('Steam started again')

    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print('\ncancelled')
        sys.exit(130)
