kytyps5-run.sh: pass the game's add-ons from ~/.config/KytyPS5-Native/addcont
and from an addcont folder in the game folder

Upstream superkeka/KytyPS5-Native 9c0c819 ("tools: add-ons file for
kytyps5-run.sh"), fitted to the beta fork's runner (no language flags).
Ghost of Yotei waits on its loading screen forever without its add-on
labels. A game folder's addcont subfolder (add-on packages with their own
sce_sys/param.json) is passed as --addcont-dir, like the launcher's add-ons
folder setting; Ghost of Yotei 02.002.000 needed that to get past its
loading screen. Applied only while the fork's runner has no add-on support.

--- a/tools/kytyps5-native/kytyps5-run.sh
+++ b/tools/kytyps5-native/kytyps5-run.sh
@@ -8,6 +8,11 @@
 # ~/.config/KytyPS5-Native/boot.webm plays before the game and exit.webm when the game is left from the
 # in-game menu (PS button). A missing file plays nothing. ~/.config/KytyPS5-Native/hdr (the plugin's HDR
 # toggle) lets the game run in HDR when gamescope outputs it.
+# ~/.config/KytyPS5-Native/addcont/<title id> lists the game's add-ons (DLC and licences), a line each:
+# <label> or <label>=<folder with its data>; a # starts a comment. A game can wait for one of them
+# forever (Ghost of Yotei stays on a black loading screen without its two).
+# <game folder>/addcont: a folder of add-on packages (each with its sce_sys/param.json), passed as
+# --addcont-dir, the way the launcher's add-ons folder setting does.
 # Saves: ~/.local/share/KytyPS5-Native/data. Log: ~/.local/share/KytyPS5-Native/logs/<title id>.log
 set -u
 HERE=$(cd "$(dirname "$0")" && pwd)
@@ -28,6 +33,14 @@ CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/KytyPS5-Native
 SHARE=${XDG_DATA_HOME:-$HOME/.local/share}/KytyPS5-Native
 mkdir -p "$SHARE/data" "$SHARE/logs"
 LOG=$SHARE/logs/$TITLE.log
+ADDCONT_ARGS=()
+if [ -f "$CONFIG/addcont/$TITLE" ]; then
+	while IFS= read -r line || [ -n "$line" ]; do
+		line=$(printf '%s' "${line%%#*}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
+		[ -n "$line" ] && ADDCONT_ARGS+=(--addcont "$line")
+	done < "$CONFIG/addcont/$TITLE"
+fi
+[ -d "$GAME/addcont" ] && ADDCONT_ARGS+=(--addcont-dir "$GAME/addcont")
 # Games run on the gamescope Xwayland Steam gives them, the base layer is set on the root one (:0).
 export DISPLAY=${DISPLAY:-:1}
 ROOT_DISPLAY=${KYTYPS5_ROOT_DISPLAY:-:0}
@@ -155,8 +168,10 @@ rm -f "$MARKER" "$VIDEO_FLAG"
 front "$GAME_APPID"
 {
 	echo "== $(date) $GAME"
+	[ ${#ADDCONT_ARGS[@]} -gt 0 ] && echo "add-ons: ${ADDCONT_ARGS[*]}"
 	SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 KYTY_EXIT_MARKER="$MARKER" KYTY_GAMESCOPE_APPID=$GAME_APPID "$EMU" --game "$GAME" \
-		--screen-width "${SCREEN%x*}" --screen-height "${SCREEN#*x}" --fullscreen --no-splash --skip-notice-screen $HDR_ARGS
+		--screen-width "${SCREEN%x*}" --screen-height "${SCREEN#*x}" --fullscreen --no-splash --skip-notice-screen $HDR_ARGS \
+		"${ADDCONT_ARGS[@]}"
 	echo "== exit=$?"
 } >> "$LOG" 2>&1 &
 EMUPID=$!
